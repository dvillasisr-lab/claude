{%- liquid
  assign beast = settings.hm_feed_beast_product
  assign count = 0
  for item in cart.items
    unless beast and item.product_id == beast.id
      assign count = count | plus: item.quantity
    endunless
  endfor
  assign best = settings.hm_best_sellers_collection
  assign best_url = routes.all_products_collection_url | append: '?sort_by=best-selling'
  if best
    assign best_url = best.url
  endif
-%}
<div class="wrap hm-cartpage">
  <div class="hm-cartpage__head">
    <h1 class="h1">{{ section.settings.heading | escape }}</h1>
    {%- if count > 0 -%}
      <a class="link" href="{{ routes.all_products_collection_url }}" style="text-decoration:underline">Keep shopping</a>
    {%- endif -%}
  </div>

  {%- if cart.item_count == 0 or count == 0 -%}
    {%- if collections.all.all_products_count == 0 -%}
      <div class="cempty hm-cartpage__empty">
        <p class="cempty__lead">Your cart is empty. Bold strategy.</p>
        {%- render 'hm-coming-soon', id: 'HmSoonCart' -%}
      </div>
    {%- else -%}
      <div class="cempty hm-cartpage__empty">
        <p class="cempty__lead">Your cart is empty. Bold strategy.</p>
        <div class="cempty__links">
          <a class="btn" href="{{ routes.all_products_collection_url }}">Shop the drop</a>
          <a href="{{ best_url }}">Best sellers</a>
        </div>
      </div>
    {%- endif -%}
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" id="hm-cart-form" class="hm-cartpage__grid" novalidate>
      <div>
        <ul class="lines" aria-label="Items in your cart">
          {%- for item in cart.items -%}
            {%- assign is_tip = false -%}
            {%- if beast and item.product_id == beast.id -%}{%- assign is_tip = true -%}{%- endif -%}
            <li class="line">
              <a class="thumb" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  {{- item.image | image_url: width: 240 | image_tag: width: 96, height: 120, widths: '96, 192', sizes: '96px', loading: 'lazy', class: 'photo', alt: '' -}}
                {%- endif -%}
              </a>
              <div>
                <p class="line__n">
                  {%- if is_tip -%}Feed The Beast{%- else -%}<a href="{{ item.url }}">{{ item.product.title | escape }}</a>{%- endif -%}
                </p>
                <p class="line__v">
                  {%- if is_tip -%}
                    Fuel tip for the crew
                  {%- elsif item.product.has_only_default_variant == false -%}
                    {{ item.variant.title | escape }}
                  {%- endif -%}
                </p>
                {%- for d in item.line_level_discount_allocations -%}
                  <p class="line__v">{{ d.discount_application.title | escape }} (−{{ d.amount | money }})</p>
                {%- endfor -%}
                {%- unless is_tip -%}
                  <label class="small muted" for="hm-cp-qty-{{ forloop.index }}">Quantity</label>
                  <input
                    class="input hm-cartpage__qty"
                    id="hm-cp-qty-{{ forloop.index }}"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    inputmode="numeric"
                  >
                {%- else -%}
                  <input type="hidden" name="updates[]" value="{{ item.quantity }}">
                {%- endunless -%}
                <a class="line__rm" href="{{ item.url_to_remove }}">Remove<span class="vh"> {{ item.product.title | escape }}</span></a>
              </div>
              <p class="num" style="margin:0">
                {%- if item.original_line_price > item.final_line_price -%}
                  <s class="muted">{{ item.original_line_price | money }}</s><br>
                {%- endif -%}
                {{ item.final_line_price | money }}
              </p>
            </li>
          {%- endfor -%}
        </ul>
        <button class="btn btn--ghost btn--sm" type="submit" name="update" style="margin-top:16px">Update cart</button>
        <div class="hm-cartpage__note">
          <label class="label" for="hm-cp-note">Add a note or gift message</label>
          <textarea class="input" id="hm-cp-note" name="note" rows="3" maxlength="200" placeholder="Gift message, or a note for the crew">{{ cart.note | escape }}</textarea>
        </div>
      </div>
      <aside class="hm-cartpage__sum" aria-label="Order summary">
        {%- for d in cart.cart_level_discount_applications -%}
          <p class="hm-cart__disc"><span>{{ d.title | escape }}</span><span class="num">−{{ d.total_allocated_amount | money }}</span></p>
        {%- endfor -%}
        <p class="drawer__sub"><span>Subtotal</span><span class="num">{{ cart.total_price | money }}</span></p>
        {%- liquid
          assign gift_only = true
          for item in cart.items
            unless item.gift_card
              assign gift_only = false
              break
            endunless
          endfor
        -%}
        <p class="small muted" style="margin:0">
          {%- if gift_only -%}
            Gift cards arrive by email. No shipping, no wait. Discount codes at checkout.
          {%- else -%}
            {%- if settings.hm_ships_line != blank %}{{ settings.hm_ships_line | escape }}. {% endif -%}
            Taxes, discount codes and shipping at checkout.
          {%- endif -%}
        </p>
        <button class="btn btn--block" type="submit" name="checkout">Checkout</button>
        {%- if additional_checkout_buttons and section.settings.show_dynamic -%}
          <div class="hm-cartpage__dyn">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}
        <p class="small muted" style="margin:0;text-align:center">Secure checkout by Shopify</p>
      </aside>
    </form>
  {%- endif -%}
</div>

{% stylesheet %}
  .hm-cartpage { padding-block: clamp(20px, 3vw, 40px) var(--sect); }
  .hm-cartpage__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 20px; margin-bottom: 20px; }
  .hm-cartpage__head .h1 { margin: 0; }
  .hm-cartpage__empty { gap: 20px; }
  .hm-cartpage__empty .cempty__lead { margin: 0; font-size: var(--t-md); color: var(--soft); }
  .hm-cartpage__empty .cempty__links { align-items: center; margin: 0; }
  .hm-cartpage__empty .cempty__links .btn { text-decoration: none; }
  .hm-cartpage__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; align-items: start; }
  @media (min-width: 900px) { .hm-cartpage__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 380px); gap: clamp(32px, 4vw, 64px); } }
  .hm-cartpage .line { grid-template-columns: 96px minmax(0, 1fr) auto; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .hm-cartpage .line .thumb { width: 96px; height: 120px; display: block; overflow: hidden; background: var(--tile); }
  .hm-cartpage .line .photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hm-cartpage .line__n a { text-decoration: none; }
  .hm-cartpage__qty { width: 80px; min-height: 36px; margin-top: 4px; }
  .hm-cartpage__note { display: grid; gap: 8px; margin-top: 24px; max-width: 520px; }
  .hm-cartpage__note textarea { padding: 10px; min-height: 80px; resize: vertical; }
  .hm-cartpage__sum { display: grid; gap: 12px; padding: 20px; background: var(--surface); border: 1px solid var(--line); }
  @media (min-width: 900px) { .hm-cartpage__sum { position: sticky; top: calc(env(safe-area-inset-top, 0px) + var(--header) + 16px); } }
  .hm-cart__disc { display: flex; justify-content: space-between; margin: 0; font-size: var(--t-xs); color: var(--soft); }
{% endstylesheet %}

{% schema %}
{
  "name": "HM Cart page",
  "tag": "section",
  "class": "hm-section hm-main-cart",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your cart"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic",
      "label": "Show Shop Pay and other express buttons",
      "default": true
    }
  ]
}
{% endschema %}
