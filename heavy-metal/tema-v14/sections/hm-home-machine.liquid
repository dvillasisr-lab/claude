{%- comment -%}
  HM Home Machine: la unica banda oscura de la home. Copia + datos (bloques) + diptico de fotos 3:4.
  Fotos vacias = fotos del boceto que vienen en assets (hm-hero.webp, hm-engine.webp).
{%- endcomment -%}
<section class="sect--night home-sect" aria-labelledby="mach-title-{{ section.id }}">
  <div class="wrap mach">
    <div class="mach__copy">
      {%- if section.settings.label != blank -%}<p class="label">{{ section.settings.label | escape }}</p>{%- endif -%}
      <h2 class="h1" id="mach-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <dl class="mach__specs">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}>
              <dt>{{ block.settings.label | escape }}</dt>
              <dd class="{% if block.settings.highlight %}unk{% else %}num{% endif %}">{{ block.settings.value | escape }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="link" href="{{ section.settings.link_url | default: routes.root_url }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="dip">
      {%- for i in (1..2) -%}
        {%- liquid
          if i == 1
            assign img = section.settings.image_1
            assign cap = section.settings.caption_1
            assign fallback = 'hm-hero.webp'
            assign fb_w = 776
            assign fb_pos = '50% 62%'
            assign fb_alt = section.settings.alt_1
          else
            assign img = section.settings.image_2
            assign cap = section.settings.caption_2
            assign fallback = 'hm-engine.webp'
            assign fb_w = 787
            assign fb_pos = '50% 40%'
            assign fb_alt = section.settings.alt_2
          endif
        -%}
        <figure>
          <div class="frame">
            {%- if img != blank -%}
              {%- capture pos -%}object-position:{{ img.presentation.focal_point }}{%- endcapture -%}
              {{
                img
                | image_url: width: 1200
                | image_tag:
                  class: 'photo',
                  alt: img.alt,
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '(max-width: 860px) 50vw, 30vw',
                  loading: 'lazy',
                  style: pos
              }}
            {%- else -%}
              <img class="photo" src="{{ fallback | asset_url }}" alt="{{ fb_alt | escape }}" loading="lazy" width="{{ fb_w }}" height="1400" style="object-position:{{ fb_pos }}">
            {%- endif -%}
          </div>
          {%- if cap != blank -%}<figcaption>{{ cap | escape }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .home-sect { padding-block: var(--sect); }
  .mach { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 4vw, 64px); align-items: center; }
  .mach__copy { display: grid; gap: 16px; justify-items: start; max-width: 440px; }
  .mach__copy .h1 { margin: 0; }
  .mach__copy .label { color: var(--accent); }
  .mach__copy p { margin: 0; color: #CFCCC3; }
  .mach__specs { display: grid; grid-template-columns: repeat(3, auto); gap: 12px 28px; margin: 4px 0 0; }
  .mach__specs div { display: grid; gap: 2px; }
  .mach__specs dt { font-size: var(--t-xs); font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #A9A59B; }
  .mach__specs dd { margin: 0; font-family: var(--f-head); font-stretch: 78%; font-size: var(--t-h2); font-weight: 700; text-transform: uppercase; line-height: 1.15; color: var(--night-ink); white-space: nowrap; }
  .mach__specs .unk { color: var(--accent); }
  .mach__copy .link { color: var(--night-ink); }
  .dip { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; margin: 0; justify-self: end; width: min(100%, calc((100svh - var(--header) - 2 * var(--sect) - 28px) * 1.5 + 4px)); }
  .dip figure { margin: 0; display: grid; gap: 8px; }
  .dip .frame { aspect-ratio: 3/4; overflow: hidden; background: #1E1E1C; }
  .dip .frame .photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dip figcaption { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: #A9A59B; }
  @media (max-width: 860px) {
    .mach { grid-template-columns: 1fr; }
    .dip { width: 100%; justify-self: stretch; }
    .mach__specs { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 16px; }
    .mach__specs dd { font-size: var(--t-md); white-space: normal; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "HM Home Machine",
  "tag": "div",
  "class": "hm-home-machine-section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "label", "label": "Etiqueta", "default": "The Machine" },
    { "type": "text", "id": "heading", "label": "Título", "default": "The only Cat V8 in the class" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "A Cat 3208 V8, reverse flow, in a Pro Stock tractor. A setup you won't find on any other tractor on the track. Everything on it is custom-built."
    },
    { "type": "text", "id": "link_label", "label": "Link: texto", "default": "Meet the machine" },
    { "type": "url", "id": "link_url", "label": "Link: destino" },
    { "type": "header", "content": "Foto 1" },
    { "type": "image_picker", "id": "image_1", "label": "Foto 1 (vertical 3:4)", "info": "Vacío = foto del tractor en la pista que viene con el tema." },
    { "type": "text", "id": "alt_1", "label": "Texto alternativo de la foto del tema", "default": "“The Evil One” pulling down the track under a tall column of black smoke" },
    { "type": "text", "id": "caption_1", "label": "Pie de foto 1", "default": "On the track" },
    { "type": "header", "content": "Foto 2" },
    { "type": "image_picker", "id": "image_2", "label": "Foto 2 (vertical 3:4)", "info": "Vacío = foto del motor que viene con el tema." },
    { "type": "text", "id": "alt_2", "label": "Texto alternativo de la foto del tema", "default": "The Cat 3208 V8 with its turbo, in the shop" },
    { "type": "text", "id": "caption_2", "label": "Pie de foto 2", "default": "Cat 3208 V8 · in the shop" }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec",
      "settings": [
        { "type": "text", "id": "label", "label": "Dato", "default": "Engine" },
        { "type": "text", "id": "value", "label": "Valor", "default": "Cat 3208 V8" },
        { "type": "checkbox", "id": "highlight", "label": "Resaltar en amarillo (por ejemplo “Unknown”)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "HM Home Machine",
      "blocks": [
        { "type": "spec", "settings": { "label": "Engine", "value": "Cat 3208 V8" } },
        { "type": "spec", "settings": { "label": "Displacement", "value": "636 to 680 ci" } },
        { "type": "spec", "settings": { "label": "Horsepower", "value": "Unknown", "highlight": true } }
      ]
    }
  ]
}
{% endschema %}
