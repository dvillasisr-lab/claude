    { "type": "text", "id": "offer_text", "label": "Text", "default": "Pick one or mix them. Every event is different, so we quote each one." },
    { "type": "text", "id": "pick_hint", "label": "Hint before picking", "default": "Tap the options you want, then ask for a quote." },
