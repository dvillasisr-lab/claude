    },
    {
      "type": "richtext",
      "id": "consent",
      "label": "Privacy line",
      "default": "<p>We use your details only to reply about your event. See our <a href=\"/policies/privacy-policy\" title=\"Privacy Policy\">Privacy Policy</a>.</p>"
    },
    { "type": "text", "id": "submit_label", "label": "Button", "default": "Send request" },
    { "type": "text", "id": "ok_label", "label": "After sending: label", "default": "Request sent" },
