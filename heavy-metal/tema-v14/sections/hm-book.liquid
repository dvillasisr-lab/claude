    { "type": "text", "id": "updated", "label": "Last updated (empty = hide)", "info": "Write it like October 1, 2026" },
    { "type": "header", "content": "How it works" },
    { "type": "text", "id": "how_title", "label": "Title", "default": "How it works" },
    { "type": "text", "id": "req_title", "label": "Requirements title", "default": "What we need from you" },
    { "type": "text", "id": "rest_label", "label": "Label for requirements with no value", "default": "The rest" },
    {
      "type": "richtext",
      "id": "alt_text",
      "label": "Sponsor note",
      "default": "<p>Want your logo on the tractor all season instead of a one-day visit? That is sponsorship. <a href=\"/pages/sponsors\" title=\"Sponsors\">See sponsor packages</a></p>"
    },
    { "type": "header", "content": "Quote form" },
    { "type": "text", "id": "topic", "label": "Email subject (topic)", "default": "Booking request" },
    { "type": "text", "id": "form_title", "label": "Title", "default": "Ask for a quote" },
    { "type": "text", "id": "form_text", "label": "Text", "default": "The more we know about your event, the faster we can say yes." },
    {
      "type": "text",
      "id": "event_types",
      "label": "Event types (separate with |)",
      "default": "County or state fair | Tractor pull | Dealership or business event | Farm show or expo | Festival or community event | Other"
    },
    {
      "type": "text",
      "id": "crowds",
      "label": "Attendance options (separate with |)",
