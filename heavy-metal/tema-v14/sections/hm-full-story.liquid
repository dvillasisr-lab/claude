{%- comment -%}
  The full story: a nostalgic scrapbook long-read.
  - The story text is the page content (Online Store > Pages, rich text editor): headings (H2), paragraphs and one quote.
  - Blocks add the scrapbook extras: "Print" (photo with tape, tilted, sepia until hover) and "Year note" (handwritten
    year in the margin). Both point to the Nth H2 of the text; hm-full-story.js places them. Without JS the prints
    show as a strip after the text.
  - Reading time and the yellow reading progress bar are computed in the browser.
{%- endcomment -%}
{%- liquid
  assign story_page = section.settings.story_page
  if story_page == blank
    assign story_page = pages['our-story']
  endif
  if story_page != blank
    assign story_url = story_page.url
  else
    assign story_url = '/pages/our-story'
  endif
  assign heading = section.settings.heading | default: page.title
-%}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500..700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400&display=swap" media="print" onload="this.media='all'">

<div class="fs" data-fs data-quote-credit="{{ section.settings.quote_credit | escape }}">
  <div class="fs-prog" aria-hidden="true"><span data-fs-bar></span></div>

  <header class="fs-hero" aria-labelledby="fs-h1-{{ section.id }}">
    {%- if section.settings.hero_image != blank -%}
      {%- assign hpos = 'object-position:' | append: section.settings.hero_position -%}
      {{ section.settings.hero_image | image_url: width: 2400 | image_tag: widths: '640, 960, 1280, 1600, 2000, 2400', sizes: '100vw', class: 'fs-hero__bg', style: hpos, fetchpriority: 'high' }}
    {%- endif -%}
    <div class="wrap">
      <div>
        <p class="fs-kicker">{% if section.settings.badge != blank %}<span class="badge">{{ section.settings.badge | escape }}</span>{% endif %}<span>{{ section.settings.kicker | escape }}</span></p>
        <h1 id="fs-h1-{{ section.id }}">{{ heading | escape }}{% if section.settings.heading_mark != blank %} <em>{{ section.settings.heading_mark | escape }}</em>{% endif %}</h1>
      </div>
      <div class="fs-hero__side">
        {%- if section.settings.dek != blank -%}<p class="fs-dek">{{ section.settings.dek | escape }}</p>{%- endif -%}
        <ul class="fs-meta">
          <li><b data-fs-rt hidden>{{ section.settings.rt_text | escape }}</b></li>
          <li><a href="{{ story_url }}">{{ section.settings.back_text | escape }}</a></li>
        </ul>
      </div>
    </div>
  </header>

  <div class="fs-read">
    <div class="fs-sheet">
      <article class="fs-body" data-fs-body>
        {{ page.content }}
      </article>

      <div class="fs-parts" data-fs-parts>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'note' -%}
              {%- if block.settings.text != blank -%}
                <span class="fs-yr" aria-hidden="true" data-fs-note data-h="{{ block.settings.heading }}" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
              {%- endif -%}
            {%- when 'print' -%}
              {%- if block.settings.image != blank or request.design_mode -%}
                {%- capture pstyle -%}--r:{{ block.settings.tilt }}deg;--r-m:{{ block.settings.tilt | divided_by: 2.0 }}deg;--ar:{{ block.settings.ratio }}{%- endcapture -%}
                <figure class="fs-pr fs-pr--{{ block.settings.side }} fs-pr--{{ block.settings.tape }}" style="{{ pstyle }}" data-fs-print data-h="{{ block.settings.heading }}" data-at="{{ block.settings.at }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {%- assign ipos = 'object-position:' | append: block.settings.position -%}
                    {{ block.settings.image | image_url: width: 1100 | image_tag: widths: '360, 540, 720, 900, 1100', sizes: '(max-width: 899px) 90vw, 420px', loading: 'lazy', style: ipos }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'fs-pr__ph' }}
                  {%- endif -%}
                  {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
                </figure>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>

      <footer class="fs-end">
        {%- if section.settings.crew_text != blank -%}
          <p class="fs-end__crew"><a href="{{ story_url }}#crew">{{ section.settings.crew_text | escape }} <span aria-hidden="true">→</span></a></p>
        {%- endif -%}
        <nav class="fs-ctas" aria-label="{{ section.settings.next_label | escape }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'link' and block.settings.label != blank -%}
              <a href="{{ block.settings.url | default: story_url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
          <a href="{{ story_url }}">{{ section.settings.back_text | escape }}</a>
        </nav>
      </footer>
    </div>
  </div>
</div>
<script src="{{ 'hm-full-story.js' | asset_url }}" defer></script>

{% stylesheet %}
.fs{--read:18px;background:var(--surface)}
.fs-prog{position:fixed;left:0;right:0;top:0;height:calc(4px + env(safe-area-inset-top,0px));padding-top:env(safe-area-inset-top,0px);z-index:70;pointer-events:none}
.fs-prog span{display:block;height:4px;background:var(--accent);transform-origin:0 50%;transform:scaleX(0)}
.fs-hero{position:relative;display:flex;align-items:flex-end;min-height:clamp(440px,64svh,660px);background:var(--night);color:var(--night-ink);overflow:hidden}
.fs-hero__bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.fs-hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(18,18,17,.30) 0%,rgba(18,18,17,.10) 30%,rgba(18,18,17,.70) 66%,rgba(18,18,17,.94) 100%),linear-gradient(90deg,rgba(18,18,17,.45) 0%,rgba(18,18,17,0) 45%,rgba(18,18,17,.35) 100%)}
.fs-hero .wrap{position:relative;z-index:1;width:100%;padding-block:clamp(56px,7vw,96px) clamp(40px,4.4vw,60px);display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:24px clamp(32px,5vw,88px);align-items:end}
.fs-kicker{display:flex;flex-wrap:wrap;align-items:center;gap:6px 14px;margin:0 0 14px;font-size:var(--t-xs);font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#E6E3DA}
.fs-kicker .badge{font-size:11px}
.fs-hero h1{font-family:var(--f-head);font-stretch:68%;font-weight:800;text-transform:uppercase;font-size:clamp(52px,7.4vw,128px);line-height:.86;letter-spacing:-.005em;margin:0;color:var(--night-ink);text-wrap:balance}
.fs-hero h1 em{font-style:normal;color:var(--accent)}
.fs-hero__side{padding-bottom:.4em}
.fs-dek{font-size:clamp(17px,.4vw + 14px,20px);line-height:1.5;color:#E6E3DA;max-width:42ch;margin:0}
.fs-meta{display:flex;flex-wrap:wrap;gap:8px 22px;margin:18px 0 0;padding:12px 0 0;border-top:1px solid rgba(242,240,233,.28);font-size:var(--t-sm);color:#CFCCC3;list-style:none;max-width:42ch}
.fs-meta b{color:var(--night-ink);font-weight:700}
.fs-meta a{color:var(--night-ink);text-underline-offset:4px}
.fs-read{--paper:#F3EBDA;--paper-ink:#2B2620;--paper-mute:#6A5F50;--print:#FFFDF7;--f-serif:'Source Serif 4','Iowan Old Style',Georgia,Charter,'Bitstream Charter','Times New Roman',serif;--f-hand:'Caveat','Reenie Beanie','Bradley Hand','Segoe Print','Marker Felt',cursive;--film:sepia(.42) saturate(.78) contrast(.94) brightness(1.04) hue-rotate(-6deg);--lm:0px;--col:640px;--gap:40px;--rm:0px;position:relative;overflow-x:clip;color:var(--paper-ink);padding-block:clamp(48px,5vw,80px) clamp(64px,7vw,112px);padding-inline:var(--gutter);background-color:var(--paper);background-image:radial-gradient(rgba(120,86,40,.07) .7px,transparent 1.3px),radial-gradient(rgba(255,255,255,.45) .8px,transparent 1.4px),radial-gradient(rgba(90,60,20,.05) 1px,transparent 1.6px),radial-gradient(ellipse 70% 40% at 15% 8%,rgba(255,250,236,.75),transparent 70%),radial-gradient(ellipse 60% 50% at 90% 60%,rgba(214,190,146,.22),transparent 70%),linear-gradient(180deg,rgba(255,252,242,.4),rgba(226,210,178,.25));background-size:5px 5px,7px 7px,13px 13px,100% 100%,100% 100%,100% 100%;background-position:0 0,3px 2px,6px 9px,0 0,0 0,0 0}
.fs-read::before{content:"";position:absolute;left:0;right:0;top:-13px;height:14px;background:var(--paper);clip-path:polygon(0% 100%,0% 36%,1.5% 53%,2.5% 15%,4.8% 16%,5.5% 44%,7.1% 20%,8% 60%,10.8% 88%,12.4% 22%,14.7% 24%,16% 61%,17.8% 15%,18.6% 64%,21% 46%,22% 74%,23.4% 30%,26.4% 68%,27.3% 88%,29.6% 22%,30.7% 13%,32.1% 71%,35.7% 56%,38.6% 48%,40% 15%,43.2% 76%,45.6% 12%,49% 20%,51.5% 16%,54.3% 76%,56% 32%,58.7% 87%,60.4% 29%,62.5% 10%,64.9% 86%,67.6% 64%,69.8% 80%,72.5% 18%,74.5% 27%,76% 10%,77.8% 12%,79.4% 59%,82% 78%,85% 17%,86.6% 76%,87.4% 12%,89.1% 52%,92.3% 79%,94.8% 23%,96.3% 53%,98.7% 75%,100% 40%,100% 100%)}
.fs-sheet{max-width:1360px;margin-inline:auto}
.fs-body,.fs-end{width:min(100%,var(--col));margin-left:var(--lm);font-size:var(--read)}
.fs-body{display:flow-root}
.fs-body p{font-family:var(--f-serif);font-size:var(--read);line-height:1.7;color:var(--paper-ink);margin:0 0 1.1em;font-optical-sizing:auto}
.fs-body>p:first-of-type{font-size:calc(var(--read) * 1.3);line-height:1.45;font-style:italic;color:var(--ink)}
.fs-body h2{position:relative;display:flow-root;font-family:var(--f-head);font-stretch:70%;font-weight:800;text-transform:uppercase;font-size:clamp(26px,1.1vw + 17px,34px);line-height:1;letter-spacing:.005em;color:var(--ink);margin:2.3em 0 .6em;text-wrap:balance}
.fs-body h2::after{content:"";display:block;width:44px;height:4px;margin-top:12px;background:var(--accent);transform:rotate(-1.5deg)}
.fs-body>h2:first-child{margin-top:0}
.fs-body strong{color:var(--ink);font-weight:700}
.fs-body a{color:var(--ink);font-weight:700;text-decoration:underline;text-decoration-color:var(--ink);text-decoration-thickness:3px;text-underline-offset:4px}
.fs-body a:hover{text-decoration-color:var(--paper-mute)}
.fs-yr{display:block;width:max-content;margin:0 0 6px;font-family:var(--f-hand);font-weight:700;font-size:30px;line-height:1;letter-spacing:0;text-transform:none;color:#3B342B;padding:0 .2em;transform:rotate(-4deg);background:linear-gradient(transparent 55%,rgba(245,196,0,.75) 55%,rgba(245,196,0,.75) 88%,transparent 88%)}
.fs-parts{display:flex;flex-wrap:wrap;gap:24px;margin-top:32px}
.fs-parts .fs-yr{display:none}
.fs-parts .fs-pr{width:min(100%,320px)}
.fs-pr{position:relative;margin:2.2em 0;padding:10px 10px 12px;background:var(--print);box-shadow:0 1px 2px rgba(60,40,10,.16),0 14px 28px -12px rgba(60,40,10,.42);transform:rotate(var(--r,0deg))}
.fs-pr img,.fs-pr .fs-pr__ph{display:block;width:100%;height:auto;aspect-ratio:var(--ar,4/5);object-fit:cover;background:#E4DACA;filter:var(--film);transition:filter .6s ease}
.fs-pr:hover img,.fs-pr:focus-within img{filter:none}
.fs-pr figcaption{margin:9px 4px 0;font-family:var(--f-hand);font-weight:600;font-size:21px;line-height:1.1;color:#3B342B}
.fs-pr--tape::before{content:"";position:absolute;z-index:1;top:-13px;left:50%;width:104px;height:28px;transform:translateX(-50%) rotate(-3deg);background:rgba(245,214,96,.62);box-shadow:0 1px 1px rgba(60,40,10,.10)}
.fs-pr--corners::before,.fs-pr--corners::after{content:"";position:absolute;z-index:1;width:84px;height:24px;background:rgba(236,224,190,.78);box-shadow:0 1px 1px rgba(60,40,10,.10)}
.fs-pr--corners::before{top:-6px;left:-26px;transform:rotate(-40deg)}
.fs-pr--corners::after{top:-6px;right:-26px;transform:rotate(40deg)}
.fs-body blockquote{position:relative;margin:1.6em 0 1.4em;padding:0;transform:rotate(-1.2deg);border:0}
.fs-body blockquote p{display:inline;font-family:var(--f-head);font-stretch:66%;font-weight:800;font-style:normal;text-transform:uppercase;font-size:clamp(44px,5vw,80px);line-height:1.02;letter-spacing:-.005em;color:var(--ink);margin:0;padding:0 .08em;-webkit-box-decoration-break:clone;box-decoration-break:clone;background:linear-gradient(transparent 50%,var(--accent) 50%,var(--accent) 90%,transparent 90%)}
.fs-body blockquote footer{display:flex;align-items:center;gap:10px;margin-top:14px;font-family:var(--f-hand);font-weight:600;font-size:26px;line-height:1;color:#3B342B}
.fs-body blockquote footer::before{content:"";width:34px;height:2px;background:currentColor;transform:rotate(-6deg)}
.fs-end{position:relative;margin-top:clamp(48px,5vw,72px);padding-top:clamp(26px,3vw,36px);border-top:2px solid var(--ink);clear:both}
.fs-end__crew{margin:0;font-family:var(--f-head);font-stretch:70%;font-weight:800;text-transform:uppercase;font-size:clamp(28px,1.6vw + 18px,40px);line-height:1.05;text-wrap:balance}
.fs-end a{color:var(--ink);text-decoration:underline;text-decoration-color:var(--ink);text-decoration-thickness:4px;text-underline-offset:7px}
.fs-end a:hover{text-decoration-color:var(--paper-mute)}
.fs-ctas{display:flex;flex-wrap:wrap;gap:10px 28px;margin:20px 0 0;font-size:var(--t-md);font-weight:700}
.fs-ctas a{text-decoration-thickness:2px;text-underline-offset:5px}
@media (min-width:900px){
  .fs-read{--lm:150px;--col:580px;--gap:32px;--rm:calc(min(100vw - 2 * var(--gutter) - 16px, 1360px) - var(--lm) - var(--col))}
  .fs-body .fs-yr{position:absolute;right:calc(100% + var(--gap));top:-4px;margin:0;font-size:32px}
  .fs-body .fs-pr--out-r{float:right;clear:right;width:calc(var(--rm) - var(--gap) - 12px);margin:.4em calc(-1 * var(--rm) + 12px) 1.6em 0}
  .fs-body .fs-pr--hang-r{float:right;clear:right;width:calc(var(--rm) + 150px);margin:.5em calc(-1 * var(--rm) + 20px) 1.4em 36px}
  .fs-body .fs-pr--hang-l,.fs-body .fs-pr--out-l{float:left;clear:left;width:calc(var(--lm) + 170px);margin:.5em 36px 1.4em calc(-1 * var(--lm))}
  .fs-body blockquote{margin:1.4em 0 1.6em calc(-1 * var(--lm))}
}
@media (min-width:900px) and (max-width:1199px){
  .fs-read{--lm:170px}
  .fs-body .fs-yr{font-size:27px}
  .fs-body .fs-pr--hang-r{width:calc(var(--rm) + 70px);margin-left:28px}
  .fs-body .fs-pr--hang-l,.fs-body .fs-pr--out-l{width:calc(var(--lm) + 110px);margin-right:28px}
}
@media (min-width:1200px){
  .fs-read{--lm:clamp(230px,20vw,300px);--col:640px;--gap:40px}
  .fs-body .fs-pr--out-l{width:calc(var(--lm) - var(--gap) - 12px);margin:.4em 0 1.6em calc(-1 * var(--lm) + 4px)}
  .fs-body .fs-pr--hang-l{width:calc(var(--lm) + 160px)}
  .fs-body blockquote{clear:both;margin:1.8em calc(-1 * var(--rm) + 40px) 1.8em calc(-1 * var(--lm) + 20px)}
  .fs-body blockquote p{font-size:clamp(56px,5.4vw,84px)}
}
@media (max-width:860px){
  .fs-hero{min-height:min(86svh,720px)}
  .fs-hero .wrap{grid-template-columns:1fr;padding-top:120px}
  .fs-hero h1{font-size:clamp(48px,14vw,84px)}
  .fs-dek,.fs-meta{max-width:none}
}
@media (max-width:899px){
  .fs-body,.fs-end{margin-inline:auto}
  .fs-body .fs-pr{margin:2em 4px}
  .fs-body .fs-pr img{aspect-ratio:4/3}
  .fs-body .fs-pr--out-r{width:78%;margin-left:auto}
  .fs-body .fs-pr--out-l{width:78%}
  .fs-body .fs-pr--out-r img,.fs-body .fs-pr--out-l img{aspect-ratio:1/1}
}
@media (max-width:600px){
  .fs-read{--read:17px}
  .fs-body .fs-pr{--r:var(--r-m,0deg)}
  .fs-yr{font-size:28px}
}
@media (prefers-reduced-motion:reduce){.fs-pr img{transition:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "Full story",
  "tag": "div",
  "class": "hm-full-story",
  "settings": [
    { "type": "paragraph", "content": "The story text is this page’s content: edit it in Online Store > Pages. Use Heading 2 for each part and Quote for the big quote. Prints and year notes are blocks below; each one points to a heading by number (1 = first heading)." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (full bleed)" },
    { "type": "text", "id": "hero_position", "label": "Hero image focus (x% y%)", "default": "50% 53%" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "The full story" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Tomah to Waterloo, WI" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Twelve years", "info": "Empty = the page title." },
    { "type": "text", "id": "heading_mark", "label": "Heading, yellow part", "default": "in the making" },
    { "type": "textarea", "id": "dek", "label": "Intro", "default": "One idea in 2014. Twelve years from idea to engine, six of them in a family shop in Waterloo, and the night the engine fired and the lights went out. This is how Heavy Metal Pro Stock: “The Evil One” came to be, in our own words." },
    { "type": "text", "id": "rt_text", "label": "Reading time text", "default": "[min] min read", "info": "[min] is replaced with the minutes (words / 200)." },
    { "type": "page", "id": "story_page", "label": "Our Story page", "info": "Empty = the page with handle our-story." },
    { "type": "text", "id": "back_text", "label": "Back link", "default": "Back to Our Story" },
    { "type": "text", "id": "quote_credit", "label": "Quote credit", "default": "Chris, owner and driver", "info": "Shown under the first quote of the text." },
    { "type": "text", "id": "crew_text", "label": "Crew link", "default": "Meet the people behind the pull", "info": "Goes to the crew on the Our Story page." },
    { "type": "text", "id": "next_label", "label": "Links label (screen readers)", "default": "What’s next" }
  ],
  "blocks": [
    {
      "type": "print",
      "name": "Print (photo)",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Alt text comes from the image." },
        { "type": "text", "id": "caption", "label": "Handwritten caption", "default": "“The Evil One”, in profile" },
        { "type": "range", "id": "heading", "label": "Next to heading number", "min": 1, "max": 20, "step": 1, "default": 1 },
        { "type": "select", "id": "at", "label": "Place it", "default": "p1", "options": [
          { "value": "h", "label": "Right after the heading" },
          { "value": "p1", "label": "After the 1st paragraph" },
          { "value": "p2", "label": "After the 2nd paragraph" }
        ] },
        { "type": "select", "id": "side", "label": "Side", "default": "out-r", "options": [
          { "value": "out-r", "label": "Right margin" },
          { "value": "hang-r", "label": "Hanging right (bigger)" },
          { "value": "out-l", "label": "Left margin" },
          { "value": "hang-l", "label": "Hanging left (bigger)" }
        ] },
        { "type": "select", "id": "tape", "label": "Tape", "default": "tape", "options": [
          { "value": "tape", "label": "One strip on top" },
          { "value": "corners", "label": "Two corners" }
        ] },
        { "type": "range", "id": "tilt", "label": "Tilt", "min": -4, "max": 4, "step": 0.2, "unit": "°", "default": 2 },
        { "type": "select", "id": "ratio", "label": "Shape", "default": "4/5", "options": [
          { "value": "4/5", "label": "Portrait 4:5" },
          { "value": "4/3", "label": "Landscape 4:3" },
          { "value": "1/1", "label": "Square" },
          { "value": "3/2", "label": "Wide 3:2" }
        ] },
        { "type": "text", "id": "position", "label": "Photo focus (x% y%)", "default": "50% 50%" }
      ]
    },
    {
      "type": "note",
      "name": "Year note",
      "settings": [
        { "type": "text", "id": "text", "label": "Handwritten year", "default": "2014" },
        { "type": "range", "id": "heading", "label": "On heading number", "min": 1, "max": 20, "step": 1, "default": 1 }
      ]
    },
    {
      "type": "link",
      "name": "Ending link",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Text", "default": "See the schedule →" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Full story",
      "blocks": [
        { "type": "note", "settings": { "text": "2014", "heading": 1 } },
        { "type": "print", "settings": { "heading": 1, "at": "p1" } }
      ]
    }
  ]
}
{% endschema %}
