{%- liquid
  assign p = product
  if p == blank
    assign p = section.settings.product
  endif
  if p == blank and collection
    assign p = collection.products.first
  endif

  assign archive = section.settings.archive_collection
  if archive == blank and collection
    assign archive = collection
  endif

  if p
    assign start_ts = ''
    assign end_ts = ''
    if p.metafields.custom.start_date.value != blank
      assign start_ts = p.metafields.custom.start_date.value | date: '%s'
    endif
    if p.metafields.custom.end_date.value != blank
      assign end_ts = p.metafields.custom.end_date.value | date: '%s'
    endif
    assign run_size = p.metafields.custom.run_size.value

    assign tracked = false
    assign left = 0
    for v in p.variants
      if v.inventory_management == 'shopify' and v.inventory_policy == 'deny'
        assign tracked = true
        if v.inventory_quantity > 0
          assign left = left | plus: v.inventory_quantity
        endif
      endif
    endfor

    assign size_pos = 0
    assign color_name = ''
    for opt in p.options_with_values
      assign oname = opt.name | downcase
      if oname contains 'size'
        assign size_pos = opt.position
      elsif oname contains 'color' or oname contains 'colour'
        assign color_name = opt.selected_value
      endif
    endfor
    assign size_idx = size_pos | minus: 1
    assign sel = p.selected_or_first_available_variant

    assign season = settings.hm_season
    if start_ts != blank
      assign season = p.metafields.custom.start_date.value | date: '%Y'
    endif
  endif
-%}

<div
  class="hm-se"
  data-hm-se
  {% if p %}
    data-start="{{ start_ts }}" data-end="{{ end_ts }}" data-available="{{ p.available }}" data-run="{{ run_size }}" data-left="{% if tracked %}{{ left }}{% endif %}"
  {% endif %}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
        <li><span aria-current="page">{% if p %}{{ p.title | escape }}{% else %}Special edition{% endif %}</span></li>
      </ol>
    </nav>

    {%- if p -%}
      <section class="drop" aria-labelledby="hm-se-name-{{ section.id }}">
        <figure class="stage" data-se-stage style="margin:0">
          <span class="stage__glow" aria-hidden="true"></span>
          <svg class="stage__bolt" viewBox="0 0 12 16" aria-hidden="true"><polygon points="8,0 1,9 5,9 3,16 11,6 7,6"/></svg>
          {%- if p.featured_media -%}
            {{- p.featured_media | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 900px) 55vw, 100vw', class: 'stage__img', alt: p.featured_media.alt | default: p.title, loading: 'eager', fetchpriority: 'high' -}}
          {%- else -%}
            {{- 'product-apparel-1' | placeholder_svg_tag: 'stage__img' -}}
          {%- endif -%}
          <span class="stage__st"><span class="st-badge" data-se-badge data-s="soon">Coming soon</span></span>
          <span class="stage__plate"><span>{{ section.settings.plate_small | escape }}</span><b>{{ section.settings.plate_big | escape }}</b></span>
        </figure>

        <div class="buy">
          <div class="buy__head">
            <div class="buy__eyebrow">
              <span class="badge badge--ink">Special edition</span>
              {%- if season != blank -%}<span class="label muted">{{ season }} season</span>{%- endif -%}
            </div>
            <h1 class="h1 buy__name" id="hm-se-name-{{ section.id }}">{{ p.title | escape }}</h1>
            <p class="buy__price">
              <span class="num">{{ sel.price | money_without_trailing_zeros }}</span>
              {%- if color_name != blank %} · {{ color_name | escape }}{% endif -%}
            </p>
            {%- assign story = p.metafields.custom.story -%}
            {%- if story != blank -%}
              <div class="buy__story">
                {%- if story.type == 'rich_text_field' -%}
                  {{ story | metafield_tag }}
                {%- else -%}
                  <p>{{ story.value | escape | newline_to_br }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if run_size != blank -%}
              <p class="label" style="color:var(--ink)">Limited run of <span class="num">{{ run_size }}</span> · for a limited time</p>
            {%- else -%}
              <p class="label" style="color:var(--ink)">Limited run · for a limited time</p>
            {%- endif -%}
          </div>

          <div class="panel">
            <div class="clock">
              <div class="clock__top">
                <p class="clock__l" data-se-l id="hm-se-clock-l-{{ section.id }}">Drop opens in</p>
                <button class="linkbtn" type="button" data-se-pause aria-pressed="false">Pause timer</button>
              </div>
              <dl class="clock__row" data-se-row aria-describedby="hm-se-clock-l-{{ section.id }}">
                <div><dt>Days</dt><dd data-se-d>00</dd></div>
                <div><dt>Hours</dt><dd data-se-h>00</dd></div>
                <div><dt>Min</dt><dd data-se-m>00</dd></div>
                <div><dt>Sec</dt><dd data-se-s>00</dd></div>
              </dl>
              <p class="clock__done" data-se-done hidden>{{ section.settings.ended_text | escape }}</p>
              <p class="clock__when" data-se-when></p>
            </div>
            {%- if tracked and run_size != blank -%}
              <div class="units">
                <div class="units__row">
                  <span data-se-units-l>Units left</span><b class="num" data-se-units>{{ left }} of {{ run_size }} left</b>
                </div>
                <div class="bar" data-se-bar aria-hidden="true"><span></span></div>
              </div>
            {%- endif -%}
            {%- if p.metafields.custom.updated.value != blank -%}
              <p class="clock__when hm-se__upd">
                Last updated: {{ p.metafields.custom.updated.value | date: '%B %-d, %Y' }}
              </p>
            {%- endif -%}
          </div>

          {%- form 'product', p, id: 'hm-se-form', class: 'hm-se__form', novalidate: 'novalidate', data-se-form: '' -%}
            <input type="hidden" name="id" value="{% if size_pos == 0 %}{{ sel.id }}{% endif %}" data-se-id>
            {%- if size_pos > 0 -%}
              <fieldset class="opt" data-se-sizes aria-describedby="hm-se-msg-{{ section.id }}">
                <legend class="opt__legend">
                  <span>Size: <b data-se-size-v>Select</b></span>
                  <a href="{{ section.settings.sizes_page_url | default: '/pages/sizes' }}">Size guide</a>
                </legend>
                <div class="sizes">
                  {%- for value in p.options_with_values[size_idx].values -%}
                    {%- liquid
                      assign match = nil
                      for v in p.variants
                        if v.options[size_idx] == value.name
                          assign same = true
                          for o in v.options
                            if forloop.index0 != size_idx and o != sel.options[forloop.index0]
                              assign same = false
                            endif
                          endfor
                          if same
                            assign match = v
                            break
                          endif
                        endif
                      endfor
                    -%}
                    <input
                      type="radio"
                      name="hm-se-size"
                      id="hm-se-sz-{{ section.id }}-{{ forloop.index }}"
                      value="{{ value.name | escape }}"
                      data-variant="{% if match %}{{ match.id }}{% endif %}"
                      {% unless match and match.available %}
                        disabled data-sold
                      {% endunless %}
                    >
                    <label class="size" for="hm-se-sz-{{ section.id }}-{{ forloop.index }}">{{ value.name | escape }}</label>
                  {%- endfor -%}
                </div>
                <p class="msg" id="hm-se-msg-{{ section.id }}" data-se-msg role="alert"></p>
              </fieldset>
            {%- endif -%}
            <button class="btn btn--block btn--big" type="submit" data-se-add hidden>
              Add to cart · {{ sel.price | money_without_trailing_zeros }}
            </button>
            <p class="msg" data-se-add-msg role="alert"></p>
          {%- endform -%}

          <section class="notify" data-se-notify aria-labelledby="hm-se-nt-{{ section.id }}">
            <h2 class="h3" id="hm-se-nt-{{ section.id }}">Notify me</h2>
            <p
              data-se-nt-p
              data-soon="{{ section.settings.notify_soon_text | escape }}"
              data-ended="{{ section.settings.notify_ended_text | escape }}"
            >
              {{ section.settings.notify_soon_text | escape }}
            </p>
            {%- form 'customer', id: 'HmNotifySpecial', novalidate: 'novalidate', data-hm-notify-form: '' -%}
              <input type="hidden" name="contact[tags]" value="notify,notify-{{ p.handle }},special-edition">
              <div class="notify__row" data-hm-form-fields>
                <label class="vh" for="hm-se-email-{{ section.id }}">Email</label>
                <input
                  class="input"
                  id="hm-se-email-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  required
                  autocomplete="email"
                  spellcheck="false"
                  placeholder="you@example.com"
                  aria-describedby="hm-se-nt-err-{{ section.id }}"
                >
                <button class="btn" type="submit">Notify me</button>
              </div>
              <p class="small notify__msg is-err" id="hm-se-nt-err-{{ section.id }}" role="alert" data-hm-form-errors>
                {%- if form.errors -%}{{ form.errors | default_errors }}{%- endif -%}
              </p>
              <p class="small notify__msg" role="status" data-hm-form-ok{% unless form.posted_successfully? %} hidden{% endunless %}>
                You’re on the list. We’ll email you once.
              </p>
            {%- endform -%}
            <p class="consent">
              Email only. Unsubscribe anytime.
              {%- if shop.privacy_policy %} See our <a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>.{% endif -%}
            </p>
          </section>

          {%- assign facts = section.blocks | where: 'type', 'fact' -%}
          {%- if facts.size > 0 -%}
            <ul class="facts">
              {%- for block in facts -%}
                <li {{ block.shopify_attributes }}>
                  {%- case block.settings.icon -%}
                    {%- when 'truck' -%}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h13v10H3zM16 10h4l1 3v4h-5"/><circle cx="7" cy="18" r="1.6"/><circle cx="18" cy="18" r="1.6"/></svg>
                    {%- when 'home' -%}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V9l8-6 8 6v12"/><path d="M9 21v-6h6v6"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7Z"/></svg>
                  {%- endcase -%}
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </section>
      {%- liquid
        assign se_ld = p | structured_data
        assign se_vendor = p.vendor | json
        assign se_brand = settings.hm_brand_name | default: shop.name | json
        assign se_from = '"@type":"Brand","name":' | append: se_vendor
        assign se_to = '"@type":"Brand","name":' | append: se_brand
        assign se_ld = se_ld | replace: se_from, se_to
      -%}
      <script type="application/ld+json">
        {{ se_ld }}
      </script>
    {%- else -%}
      <div class="hm-se__none">
        <h1 class="h1">Special edition</h1>
        {%- render 'hm-coming-soon',
          id: 'HmSoonSpecial',
          label: 'Next special edition',
          heading: 'Coming soon',
          text: section.settings.empty_text,
          tags: 'evil-list,notify,special-edition'
        -%}
      </div>
    {%- endif -%}
  </div>

  {%- liquid
    assign show_past = section.settings.show_archive
    if p == blank and archive.products_count == 0
      assign show_past = false
    endif
  -%}
  {%- if show_past -%}
    <section class="sect--white past" aria-labelledby="hm-se-past-{{ section.id }}" data-se-past>
      <div class="wrap">
        <div class="sect-head">
          <h2 class="h2" id="hm-se-past-{{ section.id }}">{{ section.settings.archive_heading | escape }}</h2>
          <p data-se-past-count role="status" aria-live="polite"></p>
        </div>
        <div class="yrs" role="group" aria-label="Filter by year" data-se-yrs hidden></div>
        <ul class="arch" data-se-arch>
          {%- if archive -%}
            {%- for ed in archive.products limit: 50 -%}
              {%- if p == blank or ed.id != p.id -%}
                {%- liquid
                  assign ed_end = ''
                  if ed.metafields.custom.end_date.value != blank
                    assign ed_end = ed.metafields.custom.end_date.value | date: '%s'
                  endif
                  assign ed_year = ed.metafields.custom.end_date.value | date: '%Y'
                  if ed_year == blank
                    assign ed_year = ed.metafields.custom.start_date.value | date: '%Y'
                  endif
                -%}
                <li class="ed" data-ed data-end="{{ ed_end }}" data-available="{{ ed.available }}" data-year="{{ ed_year }}">
                  <div class="ed__media">
                    <span class="ph ph--mock">
                      {%- if ed.featured_media -%}
                        {{- ed.featured_media | image_url: width: 600 | image_tag: widths: '200, 300, 400, 600', sizes: '(min-width: 1025px) 25vw, (min-width: 761px) 33vw, 50vw', loading: 'lazy', class: 'photo', alt: ed.featured_media.alt | default: ed.title -}}
                      {%- endif -%}
                    </span>
                    <span class="badge badge--ink">Sold out</span>
                  </div>
                  <div class="ed__txt">
                    <h3 class="card__name"><a href="{{ ed.url }}">{{ ed.title | escape }}</a></h3>
                    <p>
                      {%- if ed_year != blank %}{{ ed_year }} season{% endif -%}
                      {%- if ed.metafields.custom.run_size.value != blank %} · Run of {{ ed.metafields.custom.run_size.value }}{% endif -%}
                    </p>
                    {%- if ed.metafields.custom.story.value != blank -%}
                      <p class="ed__story">{{ ed.metafields.custom.story | metafield_text | truncatewords: 30 | escape }}</p>
                    {%- endif -%}
                  </div>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          <li class="arch__empty" data-se-empty>
            <p class="h3">{{ section.settings.archive_empty_heading | escape }}</p>
            <p>{{ section.settings.archive_empty_text | escape }}</p>
          </li>
        </ul>
      </div>
    </section>
  {%- endif -%}
</div>

<script src="{{ 'hm-special-edition.js' | asset_url }}" defer></script>

{% stylesheet %}
  .hm-se { overflow-x: clip; }
  .hm-se .crumbs { padding-block: 14px 12px; }
  .hm-se .crumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 2px 8px; font-size: var(--t-xs); color: var(--mute); }
  .hm-se .crumbs li + li::before { content: "/"; margin-right: 8px; color: #B6B1AD; }
  .hm-se .crumbs a { text-decoration: none; }
  .hm-se .crumbs a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .hm-se .crumbs [aria-current] { color: var(--ink); }
  .hm-se .drop { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(20px, 3.4vw, 56px); align-items: start; padding-bottom: var(--sect); }
  @media (max-width: 899px) { .hm-se .drop { grid-template-columns: minmax(0, 1fr); } }
  .hm-se .stage { position: relative; aspect-ratio: 4/5; max-height: calc(100svh - var(--header) - 60px); width: 100%; background: radial-gradient(120% 80% at 70% 0%, #2A2A27 0%, var(--night) 60%); overflow: hidden; display: grid; place-items: center; }
  @media (min-width: 900px) { .hm-se .stage { position: sticky; top: calc(env(safe-area-inset-top, 0px) + var(--header) + 16px); } }
  @media (max-width: 899px) { .hm-se .stage { margin-inline: calc(-1 * var(--gutter)); width: auto; aspect-ratio: 1/1; } }
  .hm-se .stage__img { position: relative; z-index: 2; width: 70%; height: auto; max-height: 82%; object-fit: contain; filter: drop-shadow(0 24px 30px rgba(0,0,0,.5)); }
  .hm-se .stage__bolt { position: absolute; z-index: 1; right: 8%; top: 6%; height: 40%; width: auto; fill: var(--accent); opacity: .9; }
  .hm-se .stage__glow { position: absolute; inset: 0; background: radial-gradient(40% 35% at 78% 22%, rgba(245,196,0,.18), transparent 70%); }
  .hm-se .stage.is-flash .stage__glow { animation: hmSeFlash 4s 1; }
  @keyframes hmSeFlash { 0%, 8%, 14%, 100% { opacity: 1; } 4%, 11% { opacity: .4; } }
  .hm-se .stage__plate { position: absolute; z-index: 3; left: 16px; bottom: 16px; background: rgba(18,18,17,.85); color: var(--night-ink, #F2F0E9); border: 1px solid #3A3936; padding: 8px 12px; display: grid; }
  .hm-se .stage__plate b { font-family: var(--f-head); font-stretch: 78%; font-size: var(--t-h2); line-height: 1.1; letter-spacing: .04em; }
  .hm-se .stage__plate span { font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #B5B2AA; }
  .hm-se .stage__st { position: absolute; z-index: 3; left: 16px; top: 16px; }
  .hm-se .buy { display: grid; gap: 18px; align-content: start; min-width: 0; }
  .hm-se .buy__head { display: grid; gap: 8px; justify-items: start; }
  .hm-se .buy__eyebrow { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .hm-se .buy__name { overflow-wrap: anywhere; min-width: 0; margin: 0; }
  .hm-se .buy__price { margin: 0; font-size: var(--t-md); font-weight: 600; color: var(--ink); }
  .hm-se .buy__story { font-size: var(--t-sm); color: var(--soft); max-width: 48ch; }
  .hm-se .buy__story p { margin: 0 0 6px; }
  .hm-se .st-badge { display: inline-flex; align-items: center; gap: 6px; padding: 3px 8px; font-size: 10px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; line-height: 1.4; }
  .hm-se .st-badge::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .hm-se .st-badge[data-s="soon"] { background: var(--surface); color: var(--ink); border: 1px solid var(--ink); }
  .hm-se .st-badge[data-s="live"] { background: var(--accent); color: var(--ink); }
  .hm-se .st-badge[data-s="live"]::before { animation: hmSePulse 1.6s 3; }
  .hm-se .st-badge[data-s="sold"] { background: var(--ink); color: var(--surface); }
  @keyframes hmSePulse { 50% { opacity: .25; } }
  @media (prefers-reduced-motion: reduce) { .hm-se .st-badge::before, .hm-se .stage__glow { animation: none !important; } }
  .hm-se .panel { border: 1px solid var(--line); background: var(--surface); display: grid; }
  .hm-se .clock { padding: 14px 16px; display: grid; gap: 8px; }
  .hm-se .clock__top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .hm-se .clock__l { margin: 0; font-size: var(--t-xs); font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--mute); }
  .hm-se .clock__row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; margin: 0; }
  .hm-se .clock__row div { display: grid; gap: 0; justify-items: start; }
  .hm-se .clock__row dd { margin: 0; font-family: var(--f-head); font-stretch: 78%; font-size: clamp(28px, 3vw, 40px); line-height: 1; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
  .hm-se .clock__row dt { font-size: 10px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--mute); order: 2; }
  .hm-se .clock__when { margin: 0; font-size: var(--t-xs); color: var(--soft); }
  .hm-se .hm-se__upd { padding: 0 16px 12px; }
  .hm-se .clock__done { margin: 0; font-family: var(--f-head); font-stretch: 78%; font-size: var(--t-h2); text-transform: uppercase; color: var(--ink); line-height: 1.15; }
  .hm-se .units { padding: 12px 16px 14px; border-top: 1px solid var(--line); display: grid; gap: 8px; }
  .hm-se .units__row { display: flex; justify-content: space-between; gap: 8px; font-size: var(--t-xs); }
  .hm-se .units__row b { color: var(--ink); }
  .hm-se .bar { height: 6px; background: var(--line); position: relative; overflow: hidden; }
  .hm-se .bar span { position: absolute; left: 0; top: 0; bottom: 0; width: var(--fill, 0%); background: var(--ink); transition: width .4s; }
  .hm-se .bar.is-low span { background: var(--alert); }
  .hm-se .bar.is-soon span { background: repeating-linear-gradient(135deg, #B9B6AF 0 4px, transparent 4px 8px); }
  .hm-se .linkbtn { background: none; border: 0; padding: 4px 0; font: inherit; font-size: 11px; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; color: var(--soft); min-height: 24px; }
  .hm-se .opt { border: 0; margin: 0; padding: 0; min-width: 0; }
  .hm-se .opt__legend { padding: 0; margin-bottom: 8px; font-size: var(--t-xs); font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--mute); width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .hm-se .opt__legend b { color: var(--ink); font-weight: 600; letter-spacing: .04em; }
  .hm-se .opt__legend a { color: var(--ink); text-transform: none; letter-spacing: .02em; text-underline-offset: 3px; }
  .hm-se .opt input { position: absolute; opacity: 0; width: 1px; height: 1px; border: 0; clip-path: inset(50%); pointer-events: none; }
  .hm-se .sizes { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 4px; }
  .hm-se .size { display: grid; place-items: center; min-height: 44px; background: var(--surface); border: 1px solid var(--line); cursor: pointer; font-size: var(--t-xs); font-weight: 700; letter-spacing: .04em; }
  .hm-se .size:hover { border-color: var(--ink); }
  .hm-se .opt input:checked + .size { background: var(--ink); border-color: var(--ink); color: var(--surface); }
  .hm-se .opt input:focus-visible + .size { outline: 2px solid var(--ink); outline-offset: 2px; }
  .hm-se .opt input:disabled + .size { background: transparent; color: var(--mute); cursor: not-allowed; text-decoration: line-through; }
  .hm-se .opt.is-off input:disabled + .size { text-decoration: none; }
  .hm-se .opt.is-error .size { border-color: var(--alert); }
  .hm-se .msg { margin: 6px 0 0; font-size: var(--t-xs); font-weight: 600; color: var(--alert); }
  .hm-se .msg:empty { display: none; }
  .hm-se .btn--big { min-height: 48px; margin-top: 12px; }
  .hm-se .notify { display: grid; gap: 8px; padding: 14px 16px; background: var(--surface); border: 1px solid var(--ink); }
  .hm-se .notify h2 { font-size: var(--t-md); margin: 0; }
  .hm-se .notify p { margin: 0; font-size: var(--t-xs); color: var(--soft); }
  .hm-se .notify__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px; }
  .hm-se .notify__msg { font-weight: 600; color: var(--ink) !important; }
  .hm-se .notify__msg:empty { display: none; }
  .hm-se .notify__msg.is-err { color: var(--alert) !important; }
  .hm-se .input[aria-invalid="true"] { border-color: var(--alert); outline: 1px solid var(--alert); }
  @media (max-width: 420px) { .hm-se .notify__row { grid-template-columns: 1fr; } }
  .hm-se .facts { list-style: none; margin: 0; padding: 12px 0 0; border-top: 1px solid var(--line); display: grid; gap: 8px; font-size: var(--t-xs); color: var(--soft); }
  .hm-se .facts li { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 8px; align-items: start; }
  .hm-se .facts svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .hm-se .facts p { margin: 0; }
  .hm-se .facts b, .hm-se .facts strong { color: var(--ink); }
  .hm-se__none { padding-block: 16px var(--sect); display: grid; gap: 20px; }
  .hm-se__none .h1 { margin: 0; }
  .hm-se .past { padding-block: clamp(32px, 4vw, 48px); }
  .hm-se .past .sect-head p { margin: 0; font-size: var(--t-xs); color: var(--mute); }
  .hm-se .yrs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
  .hm-se .yrs .chip { min-height: 36px; padding: 0 12px; background: var(--surface); border: 1px solid var(--line); font-size: var(--t-xs); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--ink); cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
  .hm-se .yrs .chip:hover { border-color: var(--ink); }
  .hm-se .yrs .chip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--surface); }
  .hm-se .yrs .chip .n { font-weight: 600; opacity: .7; }
  .hm-se .arch { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 4px; row-gap: 24px; }
  @media (max-width: 1024px) { .hm-se .arch { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .hm-se .arch { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2px; } }
  .hm-se .ed { display: grid; gap: 8px; align-content: start; }
  .hm-se .ed__media { position: relative; background: var(--tile); }
  .hm-se .ed__media .ph { --ar: 4/5; }
  .hm-se .ed__media .photo { width: 100%; height: 100%; object-fit: cover; opacity: .7; }
  .hm-se .ed__media .badge { position: absolute; left: 8px; top: 8px; }
  .hm-se .ed__txt { display: grid; gap: 2px; padding-inline: 8px; }
  .hm-se .ed__txt p { margin: 0; font-size: var(--t-xs); color: var(--mute); }
  .hm-se .ed__txt .card__name a { text-decoration: none; }
  .hm-se .arch__empty { grid-column: 1 / -1; padding: 20px 0; display: grid; gap: 6px; max-width: 52ch; }
  .hm-se .arch__empty p { margin: 0; color: var(--soft); }
  .hm-se .arch.is-wide { grid-template-columns: minmax(0, 1fr); row-gap: 16px; }
  .hm-se .arch.is-wide .ed { grid-template-columns: minmax(0, 280px) minmax(0, 1fr); gap: clamp(16px, 3vw, 48px); align-items: center; background: var(--bg); padding: clamp(12px, 1.6vw, 20px); }
  .hm-se .arch.is-wide .ed__txt { gap: 8px; padding: 0; max-width: 60ch; }
  .hm-se .arch.is-wide .ed__txt .card__name { font-size: var(--t-h2); line-height: 1.15; }
  .hm-se .arch.is-wide .ed__story { font-size: var(--t-sm); color: var(--soft); }
  @media (min-width: 1200px) { .hm-se .arch.is-wide.is-two { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 16px; } }
  @media (max-width: 600px) { .hm-se .arch.is-wide .ed { grid-template-columns: minmax(0, 120px) minmax(0, 1fr); align-items: start; } }
{% endstylesheet %}

