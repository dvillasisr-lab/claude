          <line x1="300" y1="152" x2="680" y2="152" stroke="#3A3936" stroke-width="4"/><line x1="300" y1="198" x2="680" y2="198" stroke="#3A3936" stroke-width="4"/><line x1="300" y1="244" x2="680" y2="244" stroke="#3A3936" stroke-width="4"/>
          <rect x="470" y="124" width="40" height="160" fill="#2A2A28"/>
          <circle cx="332" cy="300" r="11" fill="#9C9A92"/><circle cx="490" cy="300" r="11" fill="#9C9A92"/><circle cx="648" cy="300" r="11" fill="#9C9A92"/>
