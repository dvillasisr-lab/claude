      <rect x="1532" y="430" width="160" height="20" fill="#141413"/>
      <circle cx="1540" cy="440" r="11" fill="none" stroke="#9C9A92" stroke-width="6"/>
      <line x1="1500" y1="456" x2="1530" y2="441" stroke="#9C9A92" stroke-width="10" stroke-dasharray="12 4"/>
      <line x1="1500" y1="456" x2="1530" y2="441" stroke="#2A2A28" stroke-width="3" stroke-dasharray="12 4"/>
      <g class="nf__wheelie"><g class="nf__shake">
        {%- liquid
          if section.settings.tractor_image != blank
            assign nf_tractor = section.settings.tractor_image | image_url: width: 1400
          else
            assign nf_tractor = 'hm-tractor-cutout.webp' | asset_url
          endif
        -%}
        <image{% if section.settings.crop_cutout %} clip-path="url(#nfCut-{{ section.id }})"{% endif %} href="{{ nf_tractor }}" x="1580" y="0" width="1120" height="576" preserveAspectRatio="xMidYMax meet"/>
