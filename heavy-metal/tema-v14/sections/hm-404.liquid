{%- liquid
  assign psst_url = section.settings.psst_url
  if psst_url == blank
    assign psst_url = routes.root_url | append: '/pages/3208' | replace: '//', '/'
  endif
-%}
<section
  class="nf"
  data-hm-nf
  data-start="{{ section.settings.start_ft }}"
  data-full="{{ section.settings.full_ft }}"
  data-full-msg="{{ section.settings.full_msg | escape }}"
  aria-labelledby="hm-nf-title-{{ section.id }}"
>
  <div class="nf__sky" aria-hidden="true">
    <i class="nf__storm"></i><i class="nf__clouds"></i>
    <svg class="nf__bolt" viewBox="0 0 120 420"><path d="M70 0 L38 150 L66 150 L22 300 L52 300 L8 420 L96 250 L64 250 L104 120 L74 120 L98 0 Z" fill="#F7F9FF"/></svg>
    <i class="nf__flash"></i>
  </div>

  <div class="wrap nf__top">
    <div class="nf__copy">
      <p class="nf__k"><b>Error 404</b> · {{ section.settings.kicker | escape }}</p>
      <h1 class="nf__h1" id="hm-nf-title-{{ section.id }}">
        <span class="a">{{ section.settings.title_a | escape }}</span>
        <span class="b">{{ section.settings.start_ft }}<small>ft</small></span>
      </h1>
      {%- if section.settings.lede != blank -%}
        <p class="nf__lede">{{ section.settings.lede }}</p>
      {%- endif -%}
      {%- if section.settings.evil_text != blank -%}
        <p class="nf__evil"><span>{{ section.settings.evil_label | escape }}</span>{{ section.settings.evil_text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="nf__side">
      <form class="nf__form" action="{{ routes.search_url }}" method="get" role="search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
        <label class="vh" for="hm-nf-q-{{ section.id }}">Search the site</label>
        <input id="hm-nf-q-{{ section.id }}" name="q" type="search" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="off" enterkeyhint="search">
        <button type="submit">Search<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      </form>
      <nav class="nf__exits" aria-label="Get back on track">
        {%- if section.blocks.size > 0 -%}
          <ul>
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <a class="nf__go{% if forloop.first %} nf__go--main{% endif %}" href="{{ block.settings.link | default: routes.root_url }}">
                  {{- block.settings.label | escape -}}
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.psst_text != blank -%}
          <a class="nf__psst" href="{{ psst_url }}">{{ section.settings.psst_text | escape }}</a>
        {%- endif -%}
      </nav>
    </div>
  </div>

  <div class="nf__track" data-nf-track>
    <div class="nf__read">
      <p class="nf__dist" aria-hidden="true"><small>Distance</small><span data-nf-ft>{{ section.settings.start_ft }}</span> ft</p>
      <button class="nf__again" type="button" data-nf-again>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.3-5.6M20 4v5h-5"/></svg><span data-nf-again-t>Pull again</span>
      </button>
      <p class="nf__msg" data-nf-msg role="status" aria-live="polite"></p>
    </div>
    <div class="nf__dirt" aria-hidden="true"></div>
    <div class="nf__rail" data-nf-rail aria-hidden="true"></div>
    <div data-nf-ticks aria-hidden="true"></div>
    <div class="nf__flag" data-nf-flag aria-hidden="true"><span>Full pull</span></div>
      <svg class="nf__rig" data-nf-rig viewBox="0 0 2700 576" overflow="visible" focusable="false" role="img" aria-label="{{ section.settings.rig_label | escape }}">
      <clipPath id="nfCut-{{ section.id }}"><polygon points="1580,576 1580,195 1668,188 1688,170 1713,154 1738,143 1763,137 1788,134 1826,133 1826,0 2700,0 2700,576"/></clipPath>
      <ellipse cx="1500" cy="551" rx="1190" ry="12" fill="rgba(0,0,0,.35)"/>
      <g class="fp__sled" transform="translate(1492 548) scale(.8) translate(-1492 -548)">
        <circle cx="200" cy="443" r="105" fill="#121211"/><circle cx="440" cy="443" r="105" fill="#121211"/>
        <path d="M560 362 L640 404 L740 362 L840 404 L940 362 L1040 404 L1110 372" fill="none" stroke="#2C2C2A" stroke-width="12" stroke-linejoin="round"/>
        <rect x="24" y="318" width="1420" height="44" fill="#232321" stroke="#3A3936" stroke-width="4"/>
        <rect x="24" y="338" width="1420" height="6" fill="#F5C400"/>
