<script src="{{ 'hm-404.js' | asset_url }}" defer></script>

{% stylesheet %}
  .nf {
    --rigw: min(80vw, calc((100svh - 460px) * 3.6), 1120px);
    --righ: calc(var(--rigw) * .21333);
    --dirt: clamp(30px, 2.6vw, 44px);
    --nf-ink: #F2F0E9; --nf-soft: #D6D3CA; --nf-mute: #ABA79D; --nf-line: rgba(242,240,233,.22); --nf-panel: rgba(14,15,17,.62);
    position: relative; isolation: isolate; overflow: hidden; color: var(--nf-ink); background: #1A1D22;
    display: grid; grid-template-rows: 1fr auto; min-height: calc(100svh - var(--hdr-top, 148px)); border-bottom: 1px solid var(--ink);
  }
  .nf :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .nf__sky { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .nf__sky > * { position: absolute; }
  .nf__storm, .nf__flash { inset: 0; }
  .nf__storm { background: radial-gradient(34% 52% at 70% 40%, rgba(178,184,192,.34), rgba(150,158,168,.14) 55%, transparent 80%), radial-gradient(70% 45% at 18% 8%, rgba(112,122,138,.32), transparent 70%), radial-gradient(55% 40% at 78% 16%, rgba(92,102,118,.38), transparent 70%), radial-gradient(80% 50% at 60% 100%, rgba(140,146,152,.30), transparent 70%), linear-gradient(180deg, #14171C 0%, #20252C 38%, #363D47 72%, #525963 100%); }
  .nf__clouds { inset: -10% -20% auto; height: 62%; opacity: .6; background: radial-gradient(30% 45% at 15% 40%, #3B414B, transparent 70%), radial-gradient(28% 40% at 45% 30%, #323842, transparent 70%), radial-gradient(30% 45% at 80% 45%, #3B414B, transparent 70%); }
  .nf__flash { background: #E9EEF6; opacity: 0; mix-blend-mode: screen; }
  .nf__bolt { right: calc(var(--gutter) + 6%); top: 0; height: 70%; width: auto; opacity: 0; filter: drop-shadow(0 0 10px rgba(230,238,255,.9)); }
  .nf.is-strike .nf__flash { animation: nfFlash 1.4s steps(1, end) 1; }
  .nf.is-strike .nf__bolt { animation: nfBolt 1.4s steps(1, end) 1; }
  @keyframes nfFlash { 0% { opacity: 0; } 6% { opacity: .85; } 10% { opacity: .1; } 16% { opacity: .7; } 22% { opacity: 0; } 100% { opacity: 0; } }
  @keyframes nfBolt { 0% { opacity: 0; } 5% { opacity: 1; } 24% { opacity: 1; } 30% { opacity: 0; } 36% { opacity: .8; } 42% { opacity: 0; } 100% { opacity: 0; } }
  .nf__top { position: relative; z-index: 3; width: 100%; display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 28px clamp(32px, 5vw, 96px); align-items: end; align-self: center; padding-block: clamp(16px, 3vh, 36px) 10px; }
  .nf__copy { display: grid; gap: 14px; justify-items: start; min-width: 0; }
  .nf__k { margin: 0; font-size: var(--t-xs); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--nf-mute); }
  .nf__k b { color: var(--accent); font-weight: 700; }
  .nf__h1 { margin: 0 0 4px; font-family: var(--f-head); font-stretch: 78%; font-weight: 800; text-transform: uppercase; line-height: .86; letter-spacing: .005em; color: var(--nf-ink); text-shadow: 0 2px 18px rgba(0,0,0,.45); }
  .nf__h1 .a { display: block; font-size: clamp(26px, min(3.4vw, 5.4vh), 52px); letter-spacing: .03em; line-height: 1; }
  .nf__h1 .b { display: block; font-size: clamp(88px, min(14vw, 19vh), 232px); color: var(--accent); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .nf__h1 .b small { font-size: .36em; margin-left: .08em; color: var(--nf-ink); letter-spacing: .04em; }
  .nf__lede { margin: 0; max-width: 68ch; text-wrap: pretty; font-size: var(--t-lg); line-height: 1.45; color: var(--nf-soft); text-shadow: 0 1px 2px rgba(0,0,0,.8); }
  .nf__lede b, .nf__lede strong { color: var(--nf-ink); }
  .nf__evil { margin: 6px 0 0; max-width: 72ch; text-wrap: pretty; padding-left: 14px; border-left: 3px solid var(--accent); font-size: var(--t-md); font-style: italic; color: var(--nf-soft); text-shadow: 0 1px 2px rgba(0,0,0,.8); }
  .nf__evil span { display: block; margin-bottom: 2px; font-style: normal; font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--nf-mute); }
  .nf__side { display: grid; gap: 26px; min-width: 0; padding-bottom: 4px; }
  .nf__form { display: flex; align-items: center; gap: 10px; width: 100%; margin: 0; border-bottom: 2px solid rgba(242,240,233,.55); transition: border-color .15s; }
  .nf__form:focus-within { border-color: var(--accent); }
  .nf__form svg { flex: none; width: 20px; height: 20px; fill: none; stroke: var(--nf-mute); stroke-width: 2; }
  .nf__form input { flex: 1; min-width: 0; height: 48px; padding: 0; border: 0; border-radius: 0; background: none; color: var(--nf-ink); font: inherit; font-size: var(--t-lg); -webkit-appearance: none; appearance: none; }
  .nf__form input::placeholder { color: var(--nf-mute); }
  .nf__form input:focus { outline: none; }
  .nf__form input::-webkit-search-cancel-button { filter: invert(1); }
  .nf__form button { flex: none; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 2px; border: 0; background: none; color: var(--accent); font: inherit; font-size: var(--t-xs); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; }
  .nf__form button svg { stroke: currentColor; width: 16px; height: 16px; transition: transform .15s; }
  .nf__form button:hover svg { transform: translateX(3px); }
  .nf__exits { display: grid; gap: 10px; min-width: 0; }
  .nf__exits ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px clamp(20px, 2.2vw, 32px); }
  .nf__go { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-family: var(--f-head); font-stretch: 78%; font-weight: 800; font-size: clamp(20px, 1.7vw, 26px); letter-spacing: .03em; text-transform: uppercase; line-height: 1; color: var(--nf-ink); text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: rgba(242,240,233,.4); text-underline-offset: 7px; text-shadow: 0 1px 3px rgba(0,0,0,.7); transition: color .15s, text-decoration-color .15s; }
  .nf__go svg { width: .8em; height: .8em; fill: none; stroke: currentColor; stroke-width: 2.4; transition: transform .15s; }
  .nf__go:hover, .nf__go:focus-visible { color: var(--accent); text-decoration-color: var(--accent); }
  .nf__go:hover svg { transform: translateX(3px); }
  .nf__go--main { text-decoration-color: var(--accent); }
  .nf__track { position: relative; z-index: 2; height: calc(var(--righ) + var(--dirt) + 46px); }
  .nf__dirt { position: absolute; left: 0; right: 0; bottom: 0; height: var(--dirt); background: repeating-linear-gradient(90deg, #5C4E3A 0 6px, #514431 6px 14px); }
  .nf__dirt::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: rgba(0,0,0,.3); }
  .nf__rail { position: absolute; left: 0; bottom: var(--dirt); height: 4px; width: var(--railw, 0px); background: var(--accent); box-shadow: 0 1px 0 rgba(0,0,0,.5); transition: width 1.3s cubic-bezier(.3,.6,.2,1); }
  .nf__tick { position: absolute; bottom: calc(var(--dirt) * .3); transform: translateX(-50%); font-size: 10px; font-weight: 800; letter-spacing: .12em; color: #F7F3E8; white-space: nowrap; text-shadow: 0 1px 0 rgba(0,0,0,.35); }
  .nf__tick::before { content: ""; position: absolute; left: 50%; top: -9px; width: 2px; height: 7px; background: #F7F3E8; opacity: .8; }
  .nf__flag { position: absolute; bottom: var(--dirt); width: 6px; height: calc(var(--righ) * 1.12); box-shadow: 0 0 0 1px var(--ink); background: repeating-linear-gradient(180deg, var(--ink) 0 12px, var(--accent) 12px 24px); }
  .nf__flag::after { content: ""; position: absolute; left: 6px; top: 0; width: clamp(22px, calc(var(--rigw) * .04), 40px); aspect-ratio: 3/2; background: conic-gradient(var(--ink) 25%, #fff 0 50%, var(--ink) 0 75%, #fff 0) 0 0 / 50% 50%; border: 1px solid var(--ink); transform-origin: left center; }
  .nf__flag span { position: absolute; left: 3px; bottom: calc(100% + 8px); transform: translateX(-50%); font-size: 10px; font-weight: 800; letter-spacing: .12em; color: var(--nf-ink); white-space: nowrap; text-shadow: 0 1px 3px rgba(0,0,0,.9); }
  .nf.is-full .nf__flag::after { animation: nfWave .5s ease-in-out 6 alternate; }
  @keyframes nfWave { from { transform: skewY(-8deg) scaleX(.92); } to { transform: skewY(6deg) scaleX(1); } }
  .nf__rig { position: absolute; left: 0; bottom: calc(var(--dirt) - var(--rigw) * .0104); width: var(--rigw); height: auto; aspect-ratio: 2700/576; overflow: visible; transform: translate3d(var(--x, 0px), 0, 0); transition: transform 1.3s cubic-bezier(.3,.6,.2,1); pointer-events: none; }
  .nf__rig image { filter: drop-shadow(0 0 1.5px rgba(242,240,233,.5)); }
  .nf.is-pulling .nf__shake { animation: nfShake .11s linear infinite; }
  @keyframes nfShake { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  .nf__rig.no-anim, .nf__rail.no-anim { transition: none; }
  .nf__read { position: absolute; left: max(var(--gutter), calc((100% - var(--maxw)) / 2 + var(--gutter))); right: var(--gutter); top: 0; z-index: 3; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; font-size: var(--t-xs); }
  .nf__dist { margin: 0; font-family: var(--f-head); font-stretch: 78%; font-weight: 800; font-size: 22px; line-height: 1; font-variant-numeric: tabular-nums; color: var(--nf-ink); text-shadow: 0 1px 3px rgba(0,0,0,.8); }
  .nf__dist small { font-size: 12px; font-weight: 700; letter-spacing: .08em; color: var(--nf-mute); margin-right: 6px; }
  .nf__again { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 12px; border: 1px solid var(--nf-line); border-radius: 999px; background: var(--nf-panel); color: var(--nf-ink); font: inherit; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; cursor: pointer; }
  .nf__again:hover { border-color: var(--accent); color: var(--accent); }
  .nf__again svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2.2; }
  .nf__msg { margin: 0; color: var(--nf-soft); text-shadow: 0 1px 3px rgba(0,0,0,.9); max-width: 46ch; }
  .nf__psst { justify-self: start; padding: 2px 0 0; font-size: 11px; letter-spacing: .08em; color: var(--nf-mute); text-decoration: none; opacity: .7; min-height: 24px; display: inline-flex; align-items: center; }
  .nf__psst:hover, .nf__psst:focus-visible { color: var(--accent); opacity: 1; }
  @media (max-width: 860px) {
    .nf { --rigw: 118vw; --dirt: 30px; }
    .nf__top { grid-template-columns: minmax(0, 1fr); align-items: start; gap: 18px; }
    .nf__copy { gap: 12px; }
    .nf__side { gap: 18px; }
    .nf__track { height: calc(var(--righ) + var(--dirt) + 52px); }
  }
  @media (max-width: 600px) {
    .nf__h1 .a { font-size: 24px; }
    .nf__h1 .b { font-size: clamp(88px, 30vw, 128px); }
    .nf__lede { font-size: var(--t-md); }
    .nf__evil { font-size: var(--t-sm); }
    .nf__exits ul { gap: 4px 22px; }
    .nf__msg { flex-basis: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nf__rig, .nf__rail, .nf__go svg, .nf__form button svg { transition: none; }
    .nf.is-full .nf__flag::after, .nf.is-pulling .nf__shake { animation: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "HM 404",
  "tag": "div",
  "class": "hm-section hm-404",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Small label",
      "default": "Page not found"
    },
    {
      "type": "text",
      "id": "title_a",
      "label": "Title line",
      "default": "Pull ended at"
    },
    {
      "type": "range",
      "id": "start_ft",
      "label": "Distance shown (ft)",
      "min": 330,
      "max": 430,
      "step": 1,
      "default": 404
    },
    {
      "type": "range",
      "id": "full_ft",
      "label": "Full pull flag (ft)",
      "min": 410,
      "max": 500,
      "step": 5,
      "default": 440
    },
    {
      "type": "inline_richtext",
      "id": "lede",
      "label": "Text",
      "default": "<b>This pull ended early.</b> That page isn’t on the track. It moved, or it never made the run. Awkward."
    },
    {
      "type": "text",
      "id": "evil_label",
      "label": "Tractor voice label",
      "default": "“The Evil One” says"
    },
    {
      "type": "text",
      "id": "evil_text",
      "label": "Tractor voice line",
      "default": "You pulled off the track. Happens to the best of us. I once took out a fence post."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search placeholder",
      "default": "Search tees, hoodies..."
    },
    {
      "type": "text",
      "id": "full_msg",
      "label": "Message at full pull",
      "default": "Full pull! This thing is f#ck!ng evil. The page still isn’t here, but the shop is open."
    },
    {
      "type": "image_picker",
      "id": "tractor_image",
      "label": "Tractor cutout",
      "info": "Transparent PNG or WebP of the tractor, side view facing right (same file as the home hero). Empty = the theme tractor cutout (hm-tractor-cutout.webp)."
    },
    {
      "type": "checkbox",
      "id": "crop_cutout",
      "label": "Crop the background of the boceto cutout",
      "default": true,
      "info": "Turn off if you upload a clean cutout."
    },
    {
      "type": "text",
      "id": "rig_label",
      "label": "Picture description (screen readers)",
      "default": "“The Evil One” stopped on the track, short of the full pull flag"
    },
    {
      "type": "text",
      "id": "psst_text",
      "label": "Hidden link text",
      "default": "Psst... 3208"
    },
    {
      "type": "url",
      "id": "psst_url",
      "label": "Hidden link",
      "info": "Empty = /pages/3208"
    }
  ],
  "blocks": [
    {
      "type": "exit",
      "name": "Exit link",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HM 404"
    }
  ]
}
{% endschema %}
