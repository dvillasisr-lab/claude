        <path d="M30 318 V120 M50 318 V120 M30 300 H50 M30 270 H50 M30 240 H50 M30 210 H50 M30 180 H50 M30 150 H50" stroke="#46454F" stroke-width="5" fill="none"/>
        <rect x="56" y="98" width="232" height="220" fill="#1E1E1C" stroke="#3A3936" stroke-width="4"/>
        <rect x="88" y="120" width="184" height="118" fill="#5B6873"/>
