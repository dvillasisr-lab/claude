{%- comment -%}
  Our Story · 5 · First pull (text + quote + photo) and the yellow season band with counters from "Season stats"
  (one entry per season; a season select appears when there is more than one). Wins at 0 = "Coming soon".
{%- endcomment -%}
{%- liquid
  assign season = 'now' | date: '%Y'
  if settings.hm_season != blank
    assign season = settings.hm_season | append: ''
  endif
  assign keys = ''
  for e in shop.metaobjects.season_stats.values
    assign y = e.season.value | default: 0 | plus: 0
    assign keys = keys | append: y | append: '|' | append: e.system.handle | append: ','
  endfor
  assign keys = keys | split: ',' | sort | reverse
  assign sel = ''
  for k in keys
    assign y = k | split: '|' | first
    if y == season
      assign sel = y
    endif
  endfor
  if sel == '' and keys.size > 0
    assign sel = keys.first | split: '|' | first
  endif
-%}
<section class="sect sect--white" aria-labelledby="pull-h-{{ section.id }}">
  <div class="wrap">
    <article class="st-pull" id="{{ section.settings.anchor | default: 'first-pull' | handleize }}">
      <figure class="st-photo">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1400', sizes: '(max-width: 760px) 100vw, 55vw', class: 'photo', loading: 'lazy' }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'photo' }}
        {%- endif -%}
        {%- if section.settings.tag != blank -%}<figcaption class="st-tag">{{ section.settings.tag | escape }}</figcaption>{%- endif -%}
      </figure>
      <div class="st-pull__txt">
        <p class="st-eyebrow"><b>{{ section.settings.number | escape }}</b>{{ section.settings.eyebrow | escape }}</p>
        <h2 class="h1" id="pull-h-{{ section.id }}">{{ section.settings.title | escape }}</h2>
        {{ section.settings.text_1 }}
        {%- if section.settings.quote != blank -%}<blockquote class="st-quote"><p>{{ section.settings.quote | escape }}</p></blockquote>{%- endif -%}
        {{ section.settings.text_2 }}
      </div>
    </article>

    {%- if keys.size > 0 -%}
    <div class="st-season" id="season" data-st-season>
      <div class="st-season__h">
        <p class="label st-season__yr">
          <span>{{ section.settings.today_label | escape }}</span>
          {%- if keys.size > 1 -%}
            <label class="vh" for="season-yr-{{ section.id }}">Season</label>
            <select id="season-yr-{{ section.id }}" data-st-season-select>
              {%- for k in keys -%}
                {%- assign y = k | split: '|' | first -%}
                <option value="{{ y }}"{% if y == sel %} selected{% endif %}>{{ y }}</option>
              {%- endfor -%}
            </select>
          {%- else -%}
            <span>{{ sel }}</span>
          {%- endif -%}
          <span>season</span>
        </p>
      </div>
      {%- for k in keys -%}
        {%- liquid
          assign y = k | split: '|' | first
          assign h = k | split: '|' | last
          assign e = shop.metaobjects.season_stats[h]
          assign wins = e.wins.value | default: 0
          comment
            Competitions empty = count the Done competition pulls of that season (same number the Schedule shows)
          endcomment
          assign comps = e.competitions.value
          if comps == blank
            assign comps = 0
            for pe in shop.metaobjects.pull_event.values
              assign pes = pe.season.value | default: settings.hm_season | append: ''
              if pe.date.value != blank
                assign pes = pe.date.value | date: '%Y'
              endif
              if pes == y and pe.status.value == 'done' and pe.type.value != 'exhibition'
                assign comps = comps | plus: 1
              endif
            endfor
          endif
          if wins == 1
            assign line = 'First win in the books'
          elsif wins > 1
            assign line = wins | append: ' wins and counting'
          else
            assign line = section.settings.no_win_line
          endif
        -%}
        <div class="st-season__data" data-season="{{ y }}"{% if y != sel %} hidden{% endif %}>
          <h2 class="h2 st-season__line">{{ line | escape }}</h2>
          <dl>
            <div><dt>Competitions</dt><dd class="num">{{ comps }}<small>{{ e.competitions_note.value | default: 'this season' | escape }}</small></dd></div>
            <div><dt>Exhibitions</dt><dd class="num">{{ e.exhibitions.value | default: 0 }}<small>so far</small></dd></div>
            <div><dt>Wins</dt><dd class="num">{% if wins > 0 %}{{ wins }}<small>this season</small>{% else %}<span class="st-soon">Coming soon</span><small>chasing the first one</small>{% endif %}</dd></div>
          </dl>
          <div class="st-season__foot">
            {%- if section.settings.foot_text != blank -%}<p>{{ section.settings.foot_text | escape }}</p>{%- endif -%}
            {%- if e.updated.value != blank -%}<p class="st-upd small">Last updated: <time datetime="{{ e.updated.value | date: '%Y-%m-%d' }}">{{ e.updated.value | date: '%B %-d, %Y' }}</time></p>{%- endif -%}
            {%- if section.settings.link_text != blank and section.settings.link_url != blank -%}<a class="link" href="{{ section.settings.link_url }}">{{ section.settings.link_text | escape }}</a>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>
<script src="{{ 'hm-story.js' | asset_url }}" defer></script>

{% stylesheet %}
.st-pull{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(20px,4vw,56px);align-items:center;scroll-margin-top:var(--header)}
.st-pull .st-photo{aspect-ratio:3/2}
.st-pull__txt{display:grid;gap:12px;max-width:62ch}
.st-pull__txt p{margin:0;color:var(--soft)}
.st-pull__txt p strong,.st-pull__txt p:not(.st-eyebrow) b{color:var(--ink)}
.st-quote{margin:2px 0;padding:2px 0 2px 16px;border-left:4px solid var(--accent)}
.st-quote p{font-family:var(--f-head);font-stretch:78%;font-weight:700;text-transform:uppercase;font-size:var(--t-h1);line-height:1.12;color:var(--ink)!important;margin:0}
.st-season{margin-top:clamp(24px,3vw,36px);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2.4fr);gap:6px 32px;align-items:center;padding:18px 24px;background:var(--accent);color:var(--ink);scroll-margin-top:var(--header)}
.st-season p{margin:0}
.st-season__h{display:grid;gap:6px;grid-row:1}
.st-season__yr{display:flex;align-items:center;gap:6px;opacity:.85}
.st-season__yr select{font:inherit;letter-spacing:inherit;color:var(--ink);background:transparent;border:1px solid rgba(28,27,25,.55);padding:1px 4px;min-height:24px;cursor:pointer;border-radius:0}
.st-season__data{display:contents}
.st-season__data[hidden]{display:none!important}
.st-season__line.st-season__line{grid-column:1;grid-row:2;align-self:start;color:var(--ink)!important}
.st-season dl{grid-column:2;grid-row:1 / span 2;margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0}
.st-season dl div{padding:2px 16px;border-left:1px solid rgba(28,27,25,.35);display:grid;align-content:start}
.st-season dt{font-size:var(--t-xs);font-weight:700;letter-spacing:.06em;text-transform:uppercase;opacity:.75}
.st-season dd{margin:2px 0 0;font-family:var(--f-head);font-stretch:78%;font-weight:800;text-transform:uppercase;font-size:var(--t-h1);line-height:1.05}
.st-season dd small{display:block;font-family:var(--f-sans);font-stretch:100%;font-weight:500;text-transform:none;font-size:var(--t-xs);line-height:1.3;opacity:.8;margin-top:2px}
.st-season dd .st-soon{display:block;font-size:var(--t-h2);line-height:1.1;padding-top:4px}
.st-season__foot{grid-column:1/-1;grid-row:3;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px 24px;border-top:1px solid rgba(28,27,25,.35);padding-top:10px;margin-top:10px;font-size:var(--t-sm)}
.st-season__foot .link{color:var(--ink)}
.st-upd.st-upd{opacity:.8;font-weight:600}
@media (max-width:1200px){.st-pull{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.st-pull .st-photo{aspect-ratio:4/5}}
@media (max-width:1000px){
  .st-season{grid-template-columns:1fr}
  .st-season__line.st-season__line{grid-row:auto}
  .st-season dl{grid-column:1;grid-row:auto;margin-top:8px}
  .st-season__foot{grid-row:auto}
}
@media (max-width:760px){
  .st-pull{grid-template-columns:1fr;gap:16px}
  .st-pull .st-photo{aspect-ratio:16/10}
  .st-season{padding:16px}
  .st-season dl{border-top:1px solid rgba(28,27,25,.35)}
  .st-season dl div{padding:8px 8px 4px 10px}
  .st-season dl div:first-child{padding-left:0;border-left:0}
  .st-season dd .st-soon{font-size:var(--t-md)}
}
@media (max-width:560px){
  .st-season dt{font-size:10px;letter-spacing:.02em;overflow-wrap:anywhere}
  .st-season__yr select{min-height:36px;padding:2px 6px}
}
{% endstylesheet %}

{% schema %}
{
  "name": "Story: first pull",
  "tag": "div",
  "class": "hm-story-pull",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "first-pull" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "tag", "label": "Photo tag", "default": "First pull attempt" },
    { "type": "text", "id": "number", "label": "Chapter number", "default": "05" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "2026 · First pull" },
    { "type": "text", "id": "title", "label": "Title", "default": "The pull didn’t finish that day" },
    { "type": "richtext", "id": "text_1", "label": "Text before the quote", "default": "<p>The first pull didn’t go the way anyone hoped. A small, unexpected issue came up and the run ended before it should have. It was a disappointing day.</p>" },
    { "type": "text", "id": "quote", "label": "Quote", "default": "We won’t sugarcoat it." },
    { "type": "richtext", "id": "text_2", "label": "Text after the quote", "default": "<p>But getting the tractor onto a real track at all, twelve years after the idea and six years of building it with our own hands, was already something to be proud of. <strong>The story was just getting started.</strong></p>" },
    { "type": "header", "content": "Season band", "info": "Numbers come from Content > Metaobjects > Season stats (one entry per season). Wins at 0 show “Coming soon”." },
    { "type": "text", "id": "today_label", "label": "Label", "default": "Today ·" },
    { "type": "text", "id": "no_win_line", "label": "Headline before the first win", "default": "Chasing our first win" },
    { "type": "text", "id": "foot_text", "label": "Footer text", "default": "On the NTPA & PPL Badger State circuits. Every run goes in the Pit Log." },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "See the Pit Log" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "presets": [{ "name": "Story: first pull" }]
}
{% endschema %}
