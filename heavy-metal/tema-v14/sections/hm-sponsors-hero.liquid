{%- comment -%}
  Sponsors · dark hero. The reach number is computed from the sponsor_stats entry "main":
  pulls_per_season × fans_per_pull, with "+" (show_plus) and "(est.)" (estimated).
{%- endcomment -%}
{%- liquid
  assign stats = metaobjects.sponsor_stats.main
  assign pulls = stats.pulls_per_season.value | default: 0
  assign fans = stats.fans_per_pull.value | default: 0
  assign states = stats.states.value | default: 0
  assign plus = ''
  if stats.show_plus.value
    assign plus = '+'
  endif
  assign est = ''
  if stats.estimated.value
    assign est = ' (est.)'
  endif
  assign reach = pulls | times: fans
  assign states_txt = states | append: plus
  assign g_m = reach | divided_by: 1000000
  assign g_t = reach | modulo: 1000000 | divided_by: 1000
  assign g_u = reach | modulo: 1000
  if g_m > 0
    assign t3 = g_t | plus: 1000 | append: '' | slice: 1, 3
    assign u3 = g_u | plus: 1000 | append: '' | slice: 1, 3
    assign reach_txt = g_m | append: ',' | append: t3 | append: ',' | append: u3
  elsif g_t > 0
    assign u3 = g_u | plus: 1000 | append: '' | slice: 1, 3
    assign reach_txt = g_t | append: ',' | append: u3
  else
    assign reach_txt = g_u | append: ''
  endif
-%}

<section class="sp-band" aria-labelledby="SpTitle-{{ section.id }}">
  <figure class="sp-band__pic">
    {%- if section.settings.image != blank -%}
      {%- assign img_alt = section.settings.image.alt | default: section.settings.image_alt -%}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          widths: '600, 900, 1200, 1600',
          sizes: '(max-width: 860px) 100vw, 64vw',
          fetchpriority: 'high',
          alt: img_alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'sp-band__ph' }}
    {%- endif -%}
  </figure>
  <div class="wrap sp-band__in">
    <div class="sp-band__txt">
      <h1 class="sp-band__h1" id="SpTitle-{{ section.id }}">{{ section.settings.title }}</h1>
      {%- if reach > 0 -%}
        <p class="sp-pitch">
          <span class="sp-pitch__pre">{{ section.settings.pitch_pre }}</span>
          <span class="sp-pitch__big"
            ><span class="num">{{ reach_txt }}{{ plus }}</span
            ><small> {{ section.settings.pitch_unit }}</small></span
          >
          <span class="sp-pitch__post">across {{ pulls }}{{ plus }} pulls a season{{ est }}</span>
        </p>
      {%- endif -%}
      {%- capture facts -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.text != blank -%}
            <span {{ block.shopify_attributes }}>
              {%- if block.type == 'states' -%}
                {%- if states > 0 -%}{{ block.settings.text | replace: '[states]', states_txt }}{%- endif -%}
              {%- else -%}
                {{- block.settings.text -}}
              {%- endif -%}
            </span>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if facts != blank -%}
        <p class="sp-facts">{{ facts }}</p>
      {%- endif -%}
      <div class="sp-cta">
        {%- if section.settings.cta_label != blank -%}
          <a class="btn sp-cta__main" href="#contact" data-sp-pkg-go>{{ section.settings.cta_label }}</a>
        {%- endif -%}
        {%- if section.settings.kit_label != blank -%}
          <a class="link" href="#contact" data-sp-pkg="unsure">{{ section.settings.kit_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .sp-band{position:relative;isolation:isolate;overflow:hidden;background:var(--night);color:var(--night-ink);border-bottom:4px solid var(--accent)}
  .sp-band__pic{position:absolute;inset:0 0 0 auto;width:min(64%,1000px);margin:0;z-index:-1;background:#1E1E1C}
  .sp-band__pic img,.sp-band__pic svg{width:100%;height:100%;object-fit:cover;object-position:50% 68%;filter:saturate(.85) contrast(1.05)}
  .sp-band__pic svg{fill:#3A3936}
  .sp-band__pic::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,var(--night) 0%,rgba(18,18,17,.82) 22%,rgba(18,18,17,.25) 55%,rgba(18,18,17,0) 80%),linear-gradient(0deg,rgba(18,18,17,.55) 0%,rgba(18,18,17,0) 35%)}
  .sp-band__in.sp-band__in{position:relative;min-height:clamp(480px,40vw,600px);display:flex;align-items:center;padding-block:clamp(40px,5vw,72px)}
  .sp-band__txt{width:100%;min-width:0;display:grid;gap:clamp(16px,1.6vw,22px);justify-items:start;max-width:min(100%,820px)}
  .sp-band__h1{margin:0;font-family:var(--f-head);font-stretch:78%;font-weight:800;text-transform:uppercase;line-height:.95;letter-spacing:.01em;font-size:clamp(34px,4.2vw,60px);color:var(--night-ink);text-wrap:balance}
  .sp-pitch{margin:0;display:grid;gap:2px}
  .sp-pitch__pre,.sp-pitch__post{font-size:clamp(17px,1.5vw,21px);font-weight:600;line-height:1.3;color:var(--night-ink)}
  .sp-pitch__big{display:block;font-family:var(--f-head);font-stretch:62%;font-weight:800;text-transform:uppercase;line-height:.86;letter-spacing:-.005em;font-size:clamp(50px,9vw,140px);color:var(--accent);white-space:nowrap;margin-block:2px 4px}
  .sp-pitch__big small{font-size:.4em;font-stretch:78%;letter-spacing:.03em;color:var(--night-ink);margin-left:.1em;white-space:nowrap}
  .sp-facts{margin:0;font-size:var(--t-sm);line-height:1.5;color:#B9B5AB;max-width:56ch}
  .sp-facts span+span::before{content:"\00B7";color:var(--accent);margin-inline:.55em}
  .sp-cta{display:flex;flex-wrap:wrap;align-items:center;gap:14px 26px;margin-top:4px}
  .sp-cta__main.sp-cta__main{background:var(--accent);border-color:var(--accent);color:var(--ink);min-height:52px;padding:0 1.8em;font-size:var(--t-sm)}
  .sp-cta__main.sp-cta__main:hover{background:var(--night-ink);border-color:var(--night-ink);color:var(--ink)}
  .sp-band .link{color:var(--night-ink);font-weight:600;text-decoration:underline;text-underline-offset:4px;display:inline-flex;align-items:center;min-height:44px}
  .sp-band .link:hover{color:var(--accent)}
  .sp-band :focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  @media (max-width:860px){
    .sp-band__pic{position:relative;inset:auto;width:100%;height:clamp(200px,52vw,380px);z-index:0}
    .sp-band__pic::after{background:linear-gradient(0deg,var(--night) 0%,rgba(18,18,17,.4) 30%,rgba(18,18,17,0) 60%)}
    .sp-pitch__big{font-size:min(15.5vw,112px)}
    .sp-band__in.sp-band__in{min-height:0;margin-top:clamp(-72px,-12vw,-40px);padding-block:0 36px;z-index:1}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sponsors: hero",
  "tag": "div",
  "class": "hm-sponsors-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background photo (grandstand)" },
    { "type": "text", "id": "image_alt", "label": "Photo description (if the file has no alt text)", "default": "“The Evil One” on the track in front of a full grandstand" },
    { "type": "text", "id": "title", "label": "Title", "default": "Sponsor “The Evil One”" },
    {
      "type": "paragraph",
      "content": "The big number is calculated from Content > Metaobjects > Sponsor stats (pulls per season × fans per pull). Edit those fields, not this text."
    },
    { "type": "text", "id": "pitch_pre", "label": "Text above the number", "default": "Your brand in front of" },
    { "type": "text", "id": "pitch_unit", "label": "Word after the number", "default": "fans" },
    { "type": "text", "id": "cta_label", "label": "Main button", "default": "Request a package" },
    { "type": "text", "id": "kit_label", "label": "Info kit link", "default": "Not sure yet? Get the info kit" }
  ],
  "blocks": [
    {
      "type": "phrase",
      "name": "Phrase",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Pro Stock tractor built from scratch" }]
    },
    {
      "type": "states",
      "name": "States we pull in",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "States we pull in: [states]",
          "info": "[states] is replaced by the States field of Sponsor stats (with + when Show plus is on)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sponsors: hero",
      "blocks": [
        { "type": "phrase", "settings": { "text": "Pro Stock tractor built from scratch" } },
        { "type": "phrase", "settings": { "text": "Waterloo, WI" } },
        { "type": "phrase", "settings": { "text": "Driver with 20+ years in the sport" } },
        { "type": "states" }
      ]
    }
  ]
}
{% endschema %}
