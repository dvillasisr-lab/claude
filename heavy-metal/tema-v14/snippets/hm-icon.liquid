{% doc %}
  Renders one inline SVG icon from the HM v14 set (same drawings as the boceto). Decorative: always aria-hidden.
  Stroke icons use currentColor stroke; fill icons (pause, play, bolt, socials, check) use currentColor fill.

  @param {string} name - search | user | bag | menu | close | arrow | arrow-left | chevron-down | chevron-right | chevron-left | pause | play | bolt | facebook | instagram | youtube | tiktok | plus | minus | check | external | trash | info
  @param {number} [size] - Width and height in px (default 24; CSS can override)
  @param {string} [class] - Extra class for the svg

  @example
  {% render 'hm-icon', name: 'search', size: 22 %}
{% enddoc %}
{%- liquid
  assign s = size | default: 24
  assign stroke_attrs = 'fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"'
-%}
{%- case name -%}
  {%- when 'search' -%}
    <svg class="hm-i hm-i--search {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" {{ stroke_attrs }} aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
  {%- when 'user' -%}
    <svg class="hm-i hm-i--user {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" {{ stroke_attrs }} aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>
  {%- when 'bag' -%}
    <svg class="hm-i hm-i--bag {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" {{ stroke_attrs }} aria-hidden="true" focusable="false"><path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
  {%- when 'menu' -%}
    <svg class="hm-i hm-i--menu {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" {{ stroke_attrs }} aria-hidden="true" focusable="false"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
  {%- when 'close' -%}
    <svg class="hm-i hm-i--close {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" {{ stroke_attrs }} aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5 5 19"/></svg>
  {%- when 'arrow' -%}
    <svg class="hm-i hm-i--arrow {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- when 'arrow-left' -%}
    <svg class="hm-i hm-i--arrow-left {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
  {%- when 'chevron-down' -%}
    <svg class="hm-i hm-i--chevron-down {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" {{ stroke_attrs }} aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg>
  {%- when 'chevron-right' -%}
    <svg class="hm-i hm-i--chevron-right {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" {{ stroke_attrs }} aria-hidden="true" focusable="false"><path d="m9 6 6 6-6 6"/></svg>
  {%- when 'chevron-left' -%}
    <svg class="hm-i hm-i--chevron-left {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" {{ stroke_attrs }} aria-hidden="true" focusable="false"><path d="m15 6-6 6 6 6"/></svg>
  {%- when 'pause' -%}
    <svg class="hm-i hm-i--pause {{ class }}" viewBox="0 0 12 12" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true" focusable="false"><rect x="2" y="1" width="3" height="10"/><rect x="7" y="1" width="3" height="10"/></svg>
  {%- when 'play' -%}
    <svg class="hm-i hm-i--play {{ class }}" viewBox="0 0 12 12" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M2 1l9 5-9 5z"/></svg>
  {%- when 'bolt' -%}
    <svg class="hm-i hm-i--bolt {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
  {%- when 'facebook' -%}
    <svg class="hm-i hm-i--facebook {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v9h4v-9h3l.5-4h-3.5V9c0-.6.4-1 1-1Z"/></svg>
  {%- when 'instagram' -%}
    <svg class="hm-i hm-i--instagram {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 7.3A4.7 4.7 0 1 0 12 16.7 4.7 4.7 0 0 0 12 7.3Zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm4.9-8.9a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2ZM12 3c2.4 0 2.7 0 3.7.1 2.5.1 3.6 1.3 3.7 3.7.1.9.1 1.2.1 3.7v3c0 2.4 0 2.7-.1 3.7-.1 2.4-1.2 3.6-3.7 3.7-.9.1-1.2.1-3.7.1h-3c-2.4 0-2.7 0-3.7-.1-2.5-.1-3.6-1.3-3.7-3.7C1.5 16.2 1.5 15.9 1.5 13.5v-3c0-2.5 0-2.8.1-3.7C1.7 4.4 2.8 3.2 5.3 3.1 6.2 3 6.5 3 9 3h3Z"/></svg>
  {%- when 'youtube' -%}
    <svg class="hm-i hm-i--youtube {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8ZM9.8 15.1V8.9L15.6 12l-5.8 3.1Z"/></svg>
  {%- when 'tiktok' -%}
    <svg class="hm-i hm-i--tiktok {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M16.6 2h-3.4v13.2a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .9.1V8.9a6.4 6.4 0 1 0 5.4 6.3V8.6a8.1 8.1 0 0 0 4.4 1.3V6.5a4.6 4.6 0 0 1-4.4-4.5Z"/></svg>
  {%- when 'plus' -%}
    <svg class="hm-i hm-i--plus {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" {{ stroke_attrs }} aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}
    <svg class="hm-i hm-i--minus {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" {{ stroke_attrs }} aria-hidden="true" focusable="false"><path d="M5 12h14"/></svg>
  {%- when 'check' -%}
    <svg class="hm-i hm-i--check {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12 5 5 9-10"/></svg>
  {%- when 'external' -%}
    <svg class="hm-i hm-i--external {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" {{ stroke_attrs }} aria-hidden="true" focusable="false"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
  {%- when 'trash' -%}
    <svg class="hm-i hm-i--trash {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" {{ stroke_attrs }} aria-hidden="true" focusable="false"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></svg>
  {%- when 'info' -%}
    <svg class="hm-i hm-i--info {{ class }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" {{ stroke_attrs }} aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>
{%- endcase -%}
