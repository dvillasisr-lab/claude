{% doc %}
  Drawn product mock (the icons from the design): a black silhouette with the Heavy Metal Pro Stock: “The Evil One” mark.
  Used for category tiles and for products that have no photo yet.
  Pass `handle` (a collection handle) or `product`. Falls back to the tee.

  @param {string} [handle] - collection handle
  @param {object} [product] - product
  @param {string} [kind] - tees, sweats, hats, kids, gear or bundles

  @example
  {% render 'hm-mock', handle: link.object.handle %}
{% enddoc %}
{%- liquid
  assign kind = kind | default: ''
  if kind == blank and product
    assign t = product.type | append: ' ' | append: product.title | downcase
    if t contains 'bundle' or t contains 'pack'
      assign kind = 'bundles'
    elsif t contains 'kid' or t contains 'youth' or t contains 'toddler'
      assign kind = 'kids'
    elsif t contains 'hoodie' or t contains 'sweat' or t contains 'crewneck'
      assign kind = 'sweats'
    elsif t contains 'cap' or t contains 'hat' or t contains 'beanie'
      assign kind = 'hats'
    elsif t contains 'sticker' or t contains 'koozie' or t contains 'decal'
      assign kind = 'gear'
    endif
  elsif kind == blank and handle != blank
    case handle
      when 'sweatshirts', 'hoodies', 'sweats'
        assign kind = 'sweats'
      when 'hats', 'caps'
        assign kind = 'hats'
      when 'kids'
        assign kind = 'kids'
      when 'stickers-gear', 'gear', 'stickers'
        assign kind = 'gear'
      when 'bundles'
        assign kind = 'bundles'
    endcase
  endif
  if kind == blank
    assign kind = 'tees'
  endif
-%}
{%- if kind == 'tees' -%}
  <svg class="mock" viewBox="0 0 100 100" aria-hidden="true"><g><path d="M34 18 18 26l-10 18 14 6 6-10v52h44V40l6 10 14-6-10-18-16-8c-2 6-8 10-16 10s-14-4-16-10Z" fill="var(--ink)"/><image href="{{ 'logo-bone.svg' | asset_url }}" x="36" y="38" width="28" height="4.1"/><g fill="#ECEAE5" font-family="Archivo,Arial,sans-serif" font-weight="800" text-anchor="middle"><text x="50" y="45.2" font-size="2.4" letter-spacing=".3">PRO STOCK</text><text x="50" y="48.4" font-size="2.3">“THE EVIL ONE”</text></g></g></svg>
{%- elsif kind == 'sweats' -%}
