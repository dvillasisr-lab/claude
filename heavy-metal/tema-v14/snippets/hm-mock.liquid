{%- elsif kind == 'hats' -%}
  <svg class="mock" viewBox="0 0 100 100" aria-hidden="true"><g><path d="M20 62c0-20 13-34 30-34s30 14 30 34Zm-4 2h70c4 0 6 6 2 8-10 4-30 4-44 2H16c-4 0-4-10 0-10Z" fill="var(--ink)"/><text x="50" y="52" font-size="9" font-family="Archivo,Arial,sans-serif" font-weight="900" text-anchor="middle" fill="#ECEAE5" letter-spacing="-.3">HM</text></g></svg>
