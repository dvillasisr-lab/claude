<section class="hm hm-hero" data-hm-hero data-target="{{ section.settings.target }}" aria-label="Heavy Metal">
  <div class="hm-speedlines" aria-hidden="true"><span class="hm-speed hm-speed--accent" style="top:49%;width:197px;animation-duration:0.92s;animation-delay:0.06s"></span><span class="hm-speed" style="top:76%;width:168px;animation-duration:0.89s;animation-delay:0.07s"></span><span class="hm-speed" style="top:72%;width:229px;animation-duration:0.63s;animation-delay:0.52s"></span><span class="hm-speed" style="top:16%;width:243px;animation-duration:0.67s;animation-delay:0.51s"></span><span class="hm-speed hm-speed--accent" style="top:80%;width:183px;animation-duration:1.36s;animation-delay:0.76s"></span><span class="hm-speed" style="top:82%;width:151px;animation-duration:1.06s;animation-delay:0.48s"></span><span class="hm-speed" style="top:36%;width:143px;animation-duration:1.05s;animation-delay:0.16s"></span><span class="hm-speed" style="top:61%;width:193px;animation-duration:1.03s;animation-delay:0.69s"></span><span class="hm-speed hm-speed--accent" style="top:79%;width:212px;animation-duration:0.68s;animation-delay:0.69s"></span><span class="hm-speed" style="top:32%;width:310px;animation-duration:0.68s;animation-delay:0.85s"></span><span class="hm-speed" style="top:80%;width:150px;animation-duration:1.10s;animation-delay:0.60s"></span><span class="hm-speed" style="top:76%;width:338px;animation-duration:1.22s;animation-delay:0.56s"></span><span class="hm-speed hm-speed--accent" style="top:66%;width:305px;animation-duration:0.84s;animation-delay:0.95s"></span><span class="hm-speed" style="top:39%;width:161px;animation-duration:1.06s;animation-delay:0.63s"></span><span class="hm-speed" style="top:51%;width:349px;animation-duration:0.83s;animation-delay:1.18s"></span><span class="hm-speed" style="top:23%;width:382px;animation-duration:0.93s;animation-delay:0.91s"></span><span class="hm-speed hm-speed--accent" style="top:27%;width:370px;animation-duration:0.94s;animation-delay:1.15s"></span><span class="hm-speed" style="top:17%;width:405px;animation-duration:1.06s;animation-delay:1.05s"></span></div>
  <div class="hm-hero__top">
    <div class="hm-hero__brand">
      <h1 class="hm-hero__logo">{% render 'hm-logo', variant: 'chrome' %}</h1>
      <p class="hm-hero__tag">“{{ section.settings.tagline }}”</p>
      <div class="hm-hero__ctas">
        <a class="hm-btn hm-btn--solid" href="{{ section.settings.cta1_url }}"><span>{{ section.settings.cta1_label }}</span></a>
        <a class="hm-btn hm-btn--ghost" href="{{ section.settings.cta2_url }}"><span><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="10" fill="none" stroke="currentColor" stroke-width="1.5"/><polygon points="9,7 15.5,11 9,15" fill="currentColor"/></svg>{{ section.settings.cta2_label }}</span></a>
      </div>
    </div>
    <div class="hm-telemetry-wrap">
      <div class="hm-telemetry" aria-live="off">
        <div class="hm-telemetry__head"><span class="hm-telemetry__live"><span class="hm-dot" aria-hidden="true"></span>LIVE TELEMETRY</span><span style="color:#8C8A82">{{ section.settings.telemetry_right }}</span></div>
        <div class="hm-telemetry__body">
          <svg class="hm-tach" viewBox="0 0 240 200" role="img" aria-label="Tachometer, live RPM up to 7000"><path d="M 36.9 160.0 A 96 96 0 1 1 203.1 160.0" fill="none" stroke="#45443F" stroke-width="6" stroke-linecap="round"/><path d="M 215.7 104.8 A 96 96 0 0 1 203.1 160.0" fill="none" stroke="#F5C400" stroke-width="6" stroke-linecap="round"/><line x1="50.7" y1="152.0" x2="42.1" y2="157.0" stroke="#D8D5CB" stroke-width="2.5"/><text x="64.6" y="149.0" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="600" font-size="16" fill="#A8A59A">0</text><line x1="36.2" y1="131.1" x2="32.3" y2="132.0" stroke="#6E6B62" stroke-width="1.5"/><line x1="40.2" y1="106.0" x2="30.3" y2="105.3" stroke="#D8D5CB" stroke-width="2.5"/><text x="56.2" y="112.2" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="600" font-size="16" fill="#A8A59A">1</text><line x1="39.9" y1="80.6" x2="36.2" y2="79.1" stroke="#6E6B62" stroke-width="1.5"/><line x1="57.5" y1="62.1" x2="49.6" y2="55.9" stroke="#D8D5CB" stroke-width="2.5"/><text x="70.0" y="77.1" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="600" font-size="16" fill="#A8A59A">2</text><line x1="71.6" y1="40.9" x2="69.3" y2="37.6" stroke="#6E6B62" stroke-width="1.5"/><line x1="96.4" y1="35.6" x2="93.5" y2="26.0" stroke="#D8D5CB" stroke-width="2.5"/><text x="101.1" y="55.8" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="600" font-size="16" fill="#A8A59A">3</text><line x1="120.0" y1="26.0" x2="120.0" y2="22.0" stroke="#6E6B62" stroke-width="1.5"/><line x1="143.6" y1="35.6" x2="146.5" y2="26.0" stroke="#D8D5CB" stroke-width="2.5"/><text x="138.9" y="55.8" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="600" font-size="16" fill="#A8A59A">4</text><line x1="168.4" y1="40.9" x2="170.7" y2="37.6" stroke="#6E6B62" stroke-width="1.5"/><line x1="182.5" y1="62.1" x2="190.4" y2="55.9" stroke="#D8D5CB" stroke-width="2.5"/><text x="170.0" y="77.1" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="600" font-size="16" fill="#A8A59A">5</text><line x1="200.1" y1="80.6" x2="203.8" y2="79.1" stroke="#6E6B62" stroke-width="1.5"/><line x1="199.8" y1="106.0" x2="209.7" y2="105.3" stroke="#F5C400" stroke-width="2.5"/><text x="183.8" y="112.2" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="600" font-size="16" fill="#F5C400">6</text><line x1="203.8" y1="131.1" x2="207.7" y2="132.0" stroke="#F5C400" stroke-width="1.5"/><line x1="189.3" y1="152.0" x2="197.9" y2="157.0" stroke="#F5C400" stroke-width="2.5"/><text x="175.4" y="149.0" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="600" font-size="16" fill="#F5C400">7</text><g class="hm-needle" style="transform-origin:120px 112px;transform:rotate(-120deg)"><polygon points="116,126 124,126 121.2,32 118.8,32" fill="#F5C400"/></g><circle cx="120" cy="112" r="10" fill="#F2F0E9"/><circle cx="120" cy="112" r="4" fill="#0B0B0A"/><text class="hm-rpm" x="120" y="174" text-anchor="middle" font-family="Anton, Impact, sans-serif" font-size="30" fill="#F2F0E9">900</text><text x="120" y="192" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-size="11" letter-spacing="3" fill="#A8A59A">RPM × 1000</text></svg>
          <span class="hm-telemetry__div" aria-hidden="true"></span>
          <div class="hm-readout">
            <span class="hm-readout__label">DISTANCE</span>
            <span class="hm-readout__value"><span class="hm-readout__num" data-hm-distance>000</span><span class="hm-readout__unit">FT</span></span>
            <span class="hm-readout__target">TARGET {{ section.settings.target }} FT</span>
            <span><span class="hm-chip" data-hm-chip data-full="FULL PULL!" data-pulling="PULLING…">PULLING…</span></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="hm-track" aria-hidden="true">
    <div class="hm-track__dirt"></div>
    <div class="hm-track__line"></div>
    <div class="hm-rail">
      <div class="hm-rail__bar"></div><div class="hm-rail__fill"></div>
      <span class="hm-rail__tick" style="left:0">0 FT</span><span class="hm-rail__tick" style="left:33.33%">{{ section.settings.target | divided_by: 3 }}</span><span class="hm-rail__tick" style="left:66.66%">{{ section.settings.target | times: 2 | divided_by: 3 }}</span><span class="hm-rail__tick" style="left:100%">{{ section.settings.target }} FT</span>
    </div>
    <div class="hm-track__flag"></div>
    <div class="hm-rig"><div class="hm-rig__shake">{% render 'hm-rig' %}</div></div>
  </div>
</section>
{%- if section.settings.show_marquee -%}
<div class="hm hm-marquee" aria-hidden="true"><div class="hm-marquee__track"><span>{{ section.settings.marquee }} {{ section.settings.marquee }}</span><span>{{ section.settings.marquee }} {{ section.settings.marquee }}</span></div></div>
{%- endif -%}
{% schema %}
{
  "name": "HM Hero (animated)",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "THE EVIL ONE"
    },
    {
      "type": "text",
      "id": "cta1_label",
      "label": "Button 1 text",
      "default": "SHOP THE DROP"
    },
    {
      "type": "url",
      "id": "cta1_url",
      "label": "Button 1 link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Button 2 text",
      "default": "WATCH IT PULL"
    },
    {
      "type": "text",
      "id": "cta2_url",
      "label": "Button 2 link (use #watch for the video)",
      "default": "#watch"
    },
    {
      "type": "text",
      "id": "telemetry_right",
      "label": "Telemetry right label",
      "default": "PRO STOCK · WI"
    },
    {
      "type": "range",
      "id": "target",
      "label": "Full pull distance (ft)",
      "min": 150,
      "max": 400,
      "step": 10,
      "default": 300
    },
    {
      "type": "checkbox",
      "id": "show_marquee",
      "label": "Show yellow marquee",
      "default": true
    },
    {
      "type": "text",
      "id": "marquee",
      "label": "Marquee text",
      "default": "HEAVY METAL ● PRO STOCK ● WISCONSIN ● FULL PULL OR NOTHING ●"
    }
  ],
  "presets": [
    {
      "name": "HM Hero (animated)"
    }
  ]
}
{% endschema %}

