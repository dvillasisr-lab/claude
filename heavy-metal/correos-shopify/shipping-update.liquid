{% comment %}
NOTIFICATION: Shipping update (Settings > Notifications > Customer notifications > Shipping update)
Sent when the tracking number or carrier on a shipment changes.
SUBJECT: New tracking info for order {{ order_name }}
Brand: Heavy Metal Pro Stock: “The Evil One”. Built from boceto-v29/correos.html + hm.css. Table layout, inline CSS, 600px.
{% endcomment %}
{%- assign hm_brand = 'Heavy Metal Pro Stock: “The Evil One”' -%}
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
<meta name="color-scheme" content="light">
<meta name="supported-color-schemes" content="light">
<title>New tracking info for order {{ order_name }}</title>
<!--[if mso]><noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript><style>h1,p,td,a{font-family:Arial,sans-serif!important}</style><![endif]-->
<!--[if !mso]><!--><link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Caveat:wght@500&display=swap" rel="stylesheet"><!--<![endif]-->
<style>
body{margin:0;padding:0;width:100%!important;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}
table,td{mso-table-lspace:0pt;mso-table-rspace:0pt}
img{-ms-interpolation-mode:bicubic;border:0;outline:none;text-decoration:none}
a{color:#1C1B19}
.btn:hover{background:#4A4741!important}
@media only screen and (max-width:620px){
  .outer{padding:0!important}
  .card{border-left:0!important;border-right:0!important}
  .px{padding-left:20px!important;padding-right:20px!important}
  .h{font-size:32px!important}
  .li-img{width:64px!important;padding-left:10px!important}
  .li-pic{width:64px!important;height:64px!important}
  .gc-amt{font-size:52px!important}
  .code{font-size:20px!important;letter-spacing:.06em!important}
  .stack{display:block!important;width:100%!important;padding-left:0!important;padding-right:0!important}
  .stack-gap{padding-top:16px!important}
}
</style>
</head>
<body style="margin:0;padding:0;background:#F6F5F2;">
<div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">Same box, new tracking. Here’s the updated info.&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#F6F5F2" style="border-collapse:collapse;background:#F6F5F2;">
<tr><td align="center" class="outer" style="padding:24px 12px;">
<!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table role="presentation" class="card" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;width:100%;max-width:600px;background:#FFFFFF;border:1px solid #DEDCD6;">
<tr><td class="px" style="padding:28px 36px 0;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;border-bottom:3px solid #1C1B19;"><tr>
<td valign="middle" style="padding:0 0 14px;">
<a href="{{ shop.url }}" style="text-decoration:none;color:#1C1B19;">{% if shop.email_logo_url %}<img src="{{ shop.email_logo_url }}" alt="{{ hm_brand }}" width="{{ shop.email_logo_width | default: 200 }}" style="display:block;width:{{ shop.email_logo_width | default: 200 }}px;max-width:100%;height:auto;border:0;">{% else %}<span style="font-family:'Archivo','Arial Narrow','Helvetica Neue',Arial,sans-serif;font-stretch:78%;font-weight:800;text-transform:uppercase;letter-spacing:.01em;color:#1C1B19;font-size:18px;line-height:1.1;">{{ hm_brand }}</span>{% endif %}</a>
</td>
<td valign="middle" align="right" style="padding:0 0 14px 10px;white-space:nowrap;"><span style="display:inline-block;padding:2px 6px;background:#F5C400;color:#1C1B19;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;line-height:1.5;">Tracking update</span></td>
</tr></table>
</td></tr>
<tr><td class="px" style="padding:24px 36px 16px;"><h1 class="h" style="margin:0;font-family:'Archivo','Arial Narrow','Helvetica Neue',Arial,sans-serif;font-stretch:78%;font-weight:800;text-transform:uppercase;letter-spacing:.01em;color:#1C1B19;font-size:38px;line-height:1;">New tracking info</h1></td></tr>
<tr><td class="px" style="padding:0 36px 16px;"><p style="margin:0;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.55;color:#2D2A26;">Hey {% if customer.first_name != blank %}{{ customer.first_name }}{% elsif shipping_address.first_name != blank %}{{ shipping_address.first_name }}{% else %}there{% endif %}, the tracking on your box changed. Same gear, same road, new number. Use the one below from now on.</p></td></tr>
<tr><td class="px" style="padding:0 36px 16px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;background:#F6F5F2;border-left:3px solid #F5C400;"><tr><td style="padding:12px 14px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;"><tr><td valign="top" width="96" style="width:96px;padding:3px 12px 3px 0;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#6B6862;">Order</td><td valign="top" style="padding:3px 0;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#1C1B19;word-break:break-word;">{{ order_name }}</td></tr>
{% if fulfillment.tracking_company != blank %}<tr><td valign="top" width="96" style="width:96px;padding:3px 12px 3px 0;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#6B6862;">Carrier</td><td valign="top" style="padding:3px 0;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#1C1B19;word-break:break-word;">{{ fulfillment.tracking_company }}</td></tr>{% endif %}
{% if fulfillment.tracking_numbers.size > 0 %}{% for tn in fulfillment.tracking_numbers %}{% assign tu = fulfillment.tracking_urls[forloop.index0] %}<tr><td valign="top" width="96" style="width:96px;padding:3px 12px 3px 0;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#6B6862;">Tracking</td><td valign="top" style="padding:3px 0;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#1C1B19;word-break:break-word;">{% if tu != blank %}<a href="{{ tu }}" style="color:#1C1B19;text-decoration:underline;">{{ tn }}</a>{% else %}{{ tn }}{% endif %}</td></tr>{% endfor %}{% endif %}
{% if fulfillment.estimated_delivery_at %}<tr><td valign="top" width="96" style="width:96px;padding:3px 12px 3px 0;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#6B6862;">Arrives</td><td valign="top" style="padding:3px 0;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#1C1B19;word-break:break-word;">{{ fulfillment.estimated_delivery_at | date: "%A, %B %-d" }} (estimated)</td></tr>{% endif %}</table></td></tr></table></td></tr>
<tr><td class="px" style="padding:4px 36px 20px;">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;"><tr><td>
<!--[if mso]><v:rect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{% if fulfillment.tracking_urls.size > 0 %}{{ fulfillment.tracking_urls.first }}{% else %}{{ order_status_url }}{% endif %}" style="height:48px;v-text-anchor:middle;width:260px;" stroke="f" fillcolor="#1C1B19"><w:anchorlock/><center style="color:#FFFFFF;font-family:Arial,sans-serif;font-size:13px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;">{% if fulfillment.tracking_urls.size > 0 %}Track my package{% else %}View my order{% endif %}</center></v:rect><![endif]-->
<!--[if !mso]><!-- --><a href="{% if fulfillment.tracking_urls.size > 0 %}{{ fulfillment.tracking_urls.first }}{% else %}{{ order_status_url }}{% endif %}" class="btn" style="display:inline-block;background:#1C1B19;color:#FFFFFF;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:13px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;line-height:48px;padding:0 28px;mso-hide:all;">{% if fulfillment.tracking_urls.size > 0 %}Track my package{% else %}View my order{% endif %}</a><!--<![endif]-->
</td></tr></table></td></tr>
<tr><td class="px" style="padding:4px 36px 12px;"><p style="margin:0 0 8px;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#6B6862;">In this box</p><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">{% for line in fulfillment.fulfillment_line_items %}
<tr><td style="padding:0 0 8px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;background:#F6F5F2;border:1px solid #DEDCD6;"><tr>
<td width="96" valign="middle" class="li-img" style="width:96px;padding:12px 0 12px 12px;">{% if line.line_item.image %}<img src="{{ line.line_item | img_url: 'compact_cropped' }}" width="80" height="80" alt="{{ line.line_item.title | escape }}" class="li-pic" style="display:block;width:80px;height:80px;border:0;background:#ECEAE5;object-fit:cover;">{% else %}<div class="li-pic" style="width:80px;height:80px;background:#ECEAE5;"></div>{% endif %}</td>
<td valign="middle" style="padding:12px 14px;">
<p style="margin:0;font-family:'Archivo','Arial Narrow','Helvetica Neue',Arial,sans-serif;font-stretch:78%;font-weight:700;text-transform:uppercase;letter-spacing:.02em;font-size:16px;line-height:1.2;color:#1C1B19;">{% if line.line_item.product.title %}{{ line.line_item.product.title }}{% else %}{{ line.line_item.title }}{% endif %}</p>
<p style="margin:2px 0 0;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.4;color:#6B6862;">{% if line.line_item.variant.title and line.line_item.variant.title != 'Default Title' %}{{ line.line_item.variant.title }} · {% endif %}Qty {{ line.quantity }}</p>
</td>
<td valign="top" align="right" style="padding:12px 12px 12px 0;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;color:#1C1B19;white-space:nowrap;"></td>
</tr></table></td></tr>{% endfor %}</table></td></tr>
<tr><td class="px" style="padding:4px 36px 28px;"><p style="margin:0;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.5;font-style:italic;color:#4A4741;">Still rolling,</p><p style="margin:2px 0 0;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.5;font-weight:700;color:#1C1B19;">“The Evil One” · Cat 3208 · Waterloo, WI</p></td></tr>
<tr><td class="px" style="padding:14px 36px 18px;background:#F6F5F2;border-top:1px solid #DEDCD6;font-family:'Archivo','Helvetica Neue',Helvetica,Arial,sans-serif;font-size:11px;line-height:1.55;color:#6B6862;">
<p style="margin:0;">{{ hm_brand }} · Waterloo, WI</p>
<p style="margin:4px 0 0;">Questions? <a href="https://heavymetalprostock.com/pages/contact" style="color:#4A4741;text-decoration:underline;">Send the crew a note</a> through the contact form.</p>
</td></tr>
</table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr>
</table>
</body>
</html>
